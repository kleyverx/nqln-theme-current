{%- comment -%}
  Product Feature Cards — cards con imagen arriba + título + descripción.
  Diferente a product-benefits-pop (que no tiene imagen por card).
  Ideal para bloques "tecnología", "componentes", "materiales" del producto.
  Paleta VAULI: blanco/hueso #f6f5f1, negro #1a1a1a, acento verde #20b19e.
  Grilla configurable (2/3/4 cols) con aspect-ratio de imagen configurable.
  Sin JS. CSS con custom properties, clamp responsive y prefers-reduced-motion.

  GOTCHA :empty — el tema oculta cualquier <div> vacío con `:empty { display:none }`.
  Por eso el contenedor de imagen siempre lleva contenido (imagen o placeholder)
  y los elementos puramente visuales fuerzan display en el CSS.
{%- endcomment -%}

{%- liquid
  assign cols = section.settings.columns | default: '3'
  assign ratio = section.settings.aspect_ratio | default: '3/4'
-%}

{%- style -%}
  #ProductFeatureCards-{{ section.id }} {
    --pfc-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --pfc-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --pfc-accent: {{ section.settings.accent_color | default: '#20b19e' }};
    --pfc-cols: {{ cols }};
    --pfc-ratio: {{ ratio }};
    --pfc-radius: {{ section.settings.image_radius | default: 12 }}px;
    --pfc-max-width: {{ section.settings.content_max_width | default: 1200 }}px;
    background-color: var(--pfc-bg);
    color: var(--pfc-text);
    padding-top: {{ section.settings.padding_top | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
  }
{%- endstyle -%}

<div id="ProductFeatureCards-{{ section.id }}" class="product-feature-cards">
  <div class="product-feature-cards__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="product-feature-cards__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="product-feature-cards__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="product-feature-cards__subheading rte">{{ section.settings.subheading }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="product-feature-cards__grid" role="list">
        {%- for block in section.blocks -%}
          <li
            class="product-feature-cards__item"
            style="--pfc-index: {{ forloop.index0 }};"
            {{ block.shopify_attributes }}
          >
            <article class="product-feature-cards__card">
              <div class="product-feature-cards__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      widths: '300, 400, 600, 800, 1000, 1200',
                      sizes: '(max-width: 749px) 100vw, (max-width: 989px) 50vw, calc(100vw / var(--pfc-cols, 3))',
                      alt: block.settings.title | default: shop.name,
                      loading: 'lazy',
                      class: 'product-feature-cards__img'
                  }}
                {%- elsif request.design_mode -%}
                  <div class="product-feature-cards__placeholder" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.4">
                      <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                      <circle cx="9" cy="9" r="1.5"></circle>
                      <path d="m3 17 5-5 5 5 3-3 5 5"></path>
                    </svg>
                  </div>
                {%- else -%}
                  <div class="product-feature-cards__placeholder product-feature-cards__placeholder--flat" aria-hidden="true"></div>
                {%- endif -%}
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="product-feature-cards__title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="product-feature-cards__description">{{ block.settings.description | escape | newline_to_br }}</p>
              {%- endif -%}
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-feature-cards__inner {
    max-width: var(--pfc-max-width, 1200px);
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
    text-align: center;
  }

  .product-feature-cards__eyebrow {
    margin: 0 0 1rem;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pfc-accent, #20b19e);
  }

  .product-feature-cards__heading {
    margin: 0 0 1.2rem;
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: inherit;
  }

  .product-feature-cards__subheading {
    max-width: 720px;
    margin: 0 auto 3.2rem;
    font-size: clamp(1.5rem, 1.8vw, 1.7rem);
    line-height: 1.55;
    color: inherit;
    opacity: 0.85;
  }

  .product-feature-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--pfc-cols, 3), 1fr);
    gap: 3.2rem 2.4rem;
    margin: 3.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .product-feature-cards__item {
    display: block;
    animation: pfc-fade-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--pfc-index, 0) * 90ms);
  }

  .product-feature-cards__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
    height: 100%;
    text-align: left;
  }

  .product-feature-cards__media {
    width: 100%;
    aspect-ratio: var(--pfc-ratio, 3 / 4);
    overflow: hidden;
    border-radius: var(--pfc-radius, 12px);
    background-color: rgba(0, 0, 0, 0.04);
  }

  .product-feature-cards__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .product-feature-cards__card:hover .product-feature-cards__img,
  .product-feature-cards__card:focus-within .product-feature-cards__img {
    transform: scale(1.04);
  }

  .product-feature-cards__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: inherit;
    opacity: 0.35;
  }

  .product-feature-cards__placeholder--flat {
    background-color: rgba(0, 0, 0, 0.06);
    opacity: 1;
  }

  .product-feature-cards__title {
    margin: 0;
    font-size: clamp(1.7rem, 2vw, 2rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: inherit;
  }

  .product-feature-cards__description {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.55;
    color: inherit;
    opacity: 0.85;
  }

  @keyframes pfc-fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Tablet: 2 columnas siempre, sin importar el desktop */
  @media (max-width: 989px) {
    .product-feature-cards__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.8rem 2rem;
    }
  }

  /* Movil: 1 columna, card centrada */
  @media (max-width: 749px) {
    .product-feature-cards__inner {
      padding-left: 1.6rem;
      padding-right: 1.6rem;
    }
    .product-feature-cards__grid {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
    .product-feature-cards__card {
      align-items: center;
      text-align: center;
    }
    .product-feature-cards__media {
      max-width: 420px;
    }
  }

  /* Respeta prefers-reduced-motion: sin animaciones ni zoom */
  @media (prefers-reduced-motion: reduce) {
    .product-feature-cards__item,
    .product-feature-cards__img {
      animation: none;
      transition: none;
    }
    .product-feature-cards__card:hover .product-feature-cards__img,
    .product-feature-cards__card:focus-within .product-feature-cards__img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cards con imagen",
  "tag": "section",
  "class": "section section-product-feature-cards",
  "settings": [
    {
      "type": "paragraph",
      "content": "Cards con imagen arriba, titulo y descripcion. Ideal para 'tecnologia', 'componentes' o 'materiales' del producto. Grilla configurable de 2 a 4 columnas."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Tecnología VAULI"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título de la sección",
      "default": "Pequeño por fuera, potente por dentro"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subtítulo (opcional)"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columnas (escritorio)",
      "options": [
        { "value": "2", "label": "2 columnas" },
        { "value": "3", "label": "3 columnas" },
        { "value": "4", "label": "4 columnas" }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color del antetítulo",
      "default": "#20b19e"
    },
    {
      "type": "header",
      "content": "Fotos"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Proporción de la imagen",
      "options": [
        { "value": "3/4", "label": "Vertical (3:4)" },
        { "value": "4/3", "label": "Horizontal (4:3)" },
        { "value": "1/1", "label": "Cuadrada (1:1)" },
        { "value": "16/9", "label": "Panorámica (16:9)" }
      ],
      "default": "3/4"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Redondeo de esquinas",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho máximo",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "feature",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Título del feature"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción",
          "default": "Explica en 1-2 frases qué hace este componente o tecnología y por qué es importante para el cliente."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VAULI — Tecnología",
      "settings": {
        "eyebrow": "Tecnología VAULI",
        "heading": "Pequeño por fuera, potente por dentro",
        "columns": "3",
        "aspect_ratio": "3/4",
        "bg_color": "#ffffff",
        "text_color": "#1a1a1a",
        "accent_color": "#20b19e"
      },
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Sellador portátil inteligente",
            "description": "Control de porciones, sellado de alta velocidad, conservación óptima y batería de larga duración en un solo equipo."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Apagado automático",
            "description": "El display LED muestra la batería en todo momento y el equipo se apaga solo al terminar el sellado."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Carga USB-C",
            "description": "Lo cargas con cualquier cargador de teléfono. Sin enchufe fijo ni adaptadores raros: lo usas donde quieras."
          }
        }
      ]
    }
  ]
}
{% endschema %}
