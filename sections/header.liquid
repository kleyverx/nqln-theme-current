    color: var(--color-bg);
  }
{% endstylesheet %}

{% javascript %}
  // Info-bar carousel: 2 pastillas visibles, rota al siguiente par cada N ms.
  document.querySelectorAll('[data-info-carousel]').forEach((carousel) => {
    const items = Array.from(carousel.children);
    const total = items.length;
    if (total === 0) return;

    // Marca ready para desactivar el fallback CSS :not([data-carousel-ready]).
    carousel.setAttribute('data-carousel-ready', '');

    // Con 1 o 2 items: no rotamos, ambos siempre visibles.
    if (total <= 2) {
      items.forEach((el, i) => el.classList.add(i === 0 ? 'is-slot-1' : 'is-slot-2'));
      return;
    }

    let cursor = 0;
    const paint = () => {
      items.forEach((el) => el.classList.remove('is-slot-1', 'is-slot-2'));
      items[cursor % total].classList.add('is-slot-1');
      items[(cursor + 1) % total].classList.add('is-slot-2');
    };
    paint();

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const interval = parseInt(carousel.dataset.interval, 10) || 4000;
    setInterval(() => {
      cursor = (cursor + 2) % total;
      paint();
    }, interval);
  });

  // BCV auto-update — fetch a API publica (default ve.dolarapi.com).
  // Silent fail: si el API cae, mantiene el manual_rate.
  document.querySelectorAll('script[data-bcv-auto-update]').forEach((script) => {
    const endpoint = script.dataset.endpoint;
    const keyPath = script.dataset.keyPath || '';
    const target = script.previousElementSibling?.querySelector('[data-bcv-rate]');
    if (!endpoint || !target) return;

    fetch(endpoint, { headers: { 'Accept': 'application/json' } })
      .then((r) => r.ok ? r.json() : Promise.reject())
      .then((data) => {
        const value = keyPath ? keyPath.split('.').reduce((obj, k) => obj?.[k], data) : data;
        if (value == null) return;
        const num = typeof value === 'number' ? value : parseFloat(value);
        if (Number.isFinite(num)) {
          target.textContent = num.toLocaleString('es-VE', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          });
        }
      })
      .catch(() => {});
  });

{% endjavascript %}

