{%- comment -%}
  Header principal del tema NQLN (unificado).

  Todo lo relacionado con el header vive aqui:
  - Row principal: [search] [logo centrado] [account, wishlist, cart]
  - Franja de mensajes de seguridad + BCV como BLOCKS reordenables
    directamente desde el theme editor "Header" (sin section separada).

  Blocks disponibles:
  - benefit: icono + texto (envio gratis, pago contra entrega, garantia)
  - bcv_rate: tasa BCV con auto-update via API publica (max 1)

  Mobile-first. Sin JS excepto BCV auto-update y auto-rotate opcional.
{%- endcomment -%}

<header class="site-header" id="Header" role="banner">
  <div class="site-header__inner page-width">

    {%- if section.settings.show_search -%}
      <a
        class="site-header__action site-header__action--left"
        href="{{ routes.search_url }}"
        aria-label="{{ 'sections.header.aria_search' | t }}"
      >
        <svg class="site-header__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
    {%- endif -%}

    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_width = section.settings.logo_width | default: 120 -%}
        {%- assign logo_ratio = section.settings.logo.aspect_ratio | default: 1 -%}
        {%- assign logo_height = logo_width | divided_by: logo_ratio -%}
        {{
          section.settings.logo
          | image_url: width: 480
          | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              width: logo_width,
              height: logo_height,
              alt: shop.name,
              class: 'site-header__logo-image'
        }}
      {%- else -%}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="site-header__actions site-header__actions--right">
      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a
          class="site-header__action"
          href="{{ routes.account_url }}"
          aria-label="{{ 'sections.header.aria_account' | t }}"
        >
          <svg class="site-header__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.show_wishlist -%}
        <a
          class="site-header__action"
          href="/pages/{{ section.settings.wishlist_page_handle | default: 'wish-list' }}"
          aria-label="{{ 'sections.header.aria_wishlist' | t }}"
        >
          <svg class="site-header__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="site-header__badge" data-wishlist-count aria-hidden="true">0</span>
        </a>
      {%- endif -%}

      <a
        class="site-header__action site-header__action--cart"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'sections.header.aria_cart' | t }}"
      >
        <svg class="site-header__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="site-header__badge site-header__badge--cart" aria-label="{{ cart.item_count }} items en el carrito">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>

  </div>

  {%- comment -%} ==== Chips de colecciones PRIMERO (arriba del info-bar) ==== {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'collection_chips' -%}
      {%- liquid
        assign menu = linklists[block.settings.menu]
        assign current_handle = collection.handle | default: ''
        assign chip_style = block.settings.chip_style | default: 'pill'
        assign show_image = block.settings.show_image
      -%}
      {%- if menu != blank and menu.links.size > 0 -%}
        <nav
          class="site-header__chips site-header__chips--{{ chip_style }} {% if show_image %}site-header__chips--with-image{% endif %}"
          role="navigation"
          aria-label="{{ 'sections.header.chips_aria' | t }}"
          {{ block.shopify_attributes }}
        >
          <div class="site-header__chips-scroll">
            {%- if block.settings.show_all_link and block.settings.all_url != blank -%}
              <a class="site-header__chip" href="{{ block.settings.all_url }}">
                {%- if show_image -%}
                  <span class="site-header__chip-image site-header__chip-image--all" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                  </span>
                {%- endif -%}
                <span class="site-header__chip-name">{{ block.settings.all_label | default: 'Ver todo' }}</span>
              </a>
            {%- endif -%}
            {%- for link in menu.links -%}
              {%- assign is_active = false -%}
              {%- if link.type == 'collection_link' and link.object.handle == current_handle -%}
                {%- assign is_active = true -%}
              {%- endif -%}
              {%- assign chip_img = blank -%}
              {%- if link.type == 'collection_link' and link.object -%}
                {%- assign chip_img = link.object.image | default: link.object.products.first.featured_image -%}
              {%- elsif link.type == 'product_link' and link.object -%}
                {%- assign chip_img = link.object.featured_image -%}
              {%- endif -%}
              <a
                class="site-header__chip {% if is_active %}is-active{% endif %}"
                href="{{ link.url }}"
                {% if is_active %}aria-current="page"{% endif %}
              >
                {%- if show_image -%}
                  <span class="site-header__chip-image">
                    {%- if chip_img != blank -%}
                      {{ chip_img | image_url: width: 80 | image_tag: loading: 'lazy', width: 40, height: 40, alt: link.title, class: 'site-header__chip-img' }}
                    {%- else -%}
                      <span class="site-header__chip-initial" aria-hidden="true">{{ link.title | slice: 0, 1 | upcase }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
                <span class="site-header__chip-name">{{ link.title }}</span>
              </a>
            {%- endfor -%}
          </div>
        </nav>
      {%- elsif request.design_mode -%}
        <div class="site-header__chips">
          <div class="site-header__chips-scroll">
            <div class="site-header__chip site-header__chip--placeholder">
              <span class="site-header__chip-name">{{ 'sections.header.chips_placeholder' | t }}</span>
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} ==== Franja de mensajes + BCV DEBAJO (grid 2x2 pastillas) ==== {%- endcomment -%}
  {%- assign has_info_blocks = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'benefit' or block.type == 'bcv_rate' -%}
      {%- assign has_info_blocks = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if has_info_blocks -%}
    {%- liquid
      assign bar_bg = section.settings.info_bar_bg
      if bar_bg == blank
        assign bar_bg = settings.color_brand_secondary
      endif
      if bar_bg == blank
        assign bar_bg = '#20b19e'
      endif
      assign bar_fg = section.settings.info_bar_fg
      if bar_fg == blank
        assign bar_fg = '#ffffff'
      endif
    -%}
    <div
      class="site-header__info-bar"
      role="region"
      aria-label="{{ 'sections.header.info_bar_aria' | t }}"
      style="--info-bar-bg: {{ bar_bg }}; --info-bar-fg: {{ bar_fg }};"
    >
      <div class="site-header__info-scroll" data-info-carousel data-interval="{{ section.settings.rotate_interval | default: 4000 }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'benefit' -%}
              <div class="site-header__info-item" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != 'none' -%}
                  <span class="site-header__info-icon" aria-hidden="true">
                    {%- case block.settings.icon -%}
                      {%- when 'shipping' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                      {%- when 'payment' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                      {%- when 'shield' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
                      {%- when 'check' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                      {%- when 'lock' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                      {%- when 'support' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3v4Z"/><path d="M3 19a2 2 0 0 0 2 2h1v-6H3v4Z"/></svg>
                      {%- when 'return' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 4v5h5"/></svg>
                      {%- when 'gift' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/></svg>
                    {%- endcase -%}
                  </span>
                {%- endif -%}
                <span class="site-header__info-text-stack">
                  <span class="site-header__info-title">{{ block.settings.text }}</span>
                  {%- if block.settings.subtitle != blank -%}
                    <span class="site-header__info-subtitle">{{ block.settings.subtitle }}</span>
                  {%- endif -%}
                </span>
              </div>

            {%- when 'bcv_rate' -%}
              <div class="site-header__info-item site-header__info-item--bcv" {{ block.shopify_attributes }}>
                <span class="site-header__info-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </span>
                <span class="site-header__info-text-stack">
                  <span class="site-header__info-title">
                    {{ block.settings.label }}
                    <strong data-bcv-rate>{{ block.settings.manual_rate }}</strong>{{ block.settings.suffix }}
                  </span>
                  {%- if block.settings.subtitle != blank -%}
                    <span class="site-header__info-subtitle">{{ block.settings.subtitle }}</span>
                  {%- endif -%}
                </span>
                {%- if block.settings.auto_update -%}
                  <script data-bcv-auto-update
                    data-endpoint="{{ block.settings.api_endpoint | default: 'https://ve.dolarapi.com/v1/dolares/oficial' }}"
                    data-key-path="{{ block.settings.api_key_path | default: 'promedio' }}"
                  ></script>
                {%- endif -%}
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

</header>

{% stylesheet %}
  /* HEADER MOBILE — TODO oculto en tablet+desktop (>=750px).
     Regla del proyecto: ningun componente de esta section (inner, info-bar,
     chips) debe verse en desktop. El desktop tiene su propia section
     'Header Desktop' separada.
     Ver: memory/project-header-mobile-oculto-desktop.md */
  .site-header {
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.03);
  }

  .site-header__inner {
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 750px) {
    .site-header {
      display: none;
    }
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-sm);
    min-height: 56px;
    padding-top: var(--space-sm);
    padding-bottom: var(--space-sm);
  }

  .site-header__logo {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-text);
    max-width: 60vw;
  }

  .site-header__logo-image {
    display: block;
    height: auto;
    max-height: 36px;
    width: auto;
    object-fit: contain;
  }

  .site-header__logo-text {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--color-text);
    white-space: nowrap;
  }

  .site-header__actions {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .site-header__actions--right {
    justify-self: end;
  }

  .site-header__action {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background 150ms ease, color 150ms ease;
  }

  .site-header__action:hover,
  .site-header__action:focus-visible {
    background: var(--color-bg-soft);
  }

  .site-header__action--left {
    justify-self: start;
  }

  .site-header__icon {
    width: 22px;
    height: 22px;
    display: block;
  }

  .site-header__badge {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: var(--radius-full);
    background: var(--color-brand-primary);
    color: var(--color-text);
    font-size: 11px;
    font-weight: var(--font-weight-strong);
    line-height: 18px;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .site-header__badge--cart {
    background: var(--color-brand-secondary);
    color: var(--color-bg);
  }

  .site-header__badge[data-wishlist-count]:not([data-count]) {
    display: none;
  }

  /* Sin media queries de tablet/desktop aca: este header se OCULTA a partir
     de 750px (regla arriba). El header desktop es una section separada. */

  /* ============================================================
     Franja de mensajes de seguridad + BCV
     Mobile: pastillas turquesa con circulo blanco a la izq (icono
     dentro) + titulo bold + subtitle opcional debajo.
     ============================================================ */
  .site-header__info-bar {
    color: var(--info-bar-fg);
    padding: 8px var(--space-md);
    background: transparent;
  }

  /* Carousel: solo 2 pastillas visibles a la vez (una a cada lado).
     Todos los items apilados con position absolute. El JS asigna
     is-slot-1 (izq) o is-slot-2 (der) al par activo. */
  .site-header__info-scroll {
    position: relative;
    min-height: 40px;
    perspective: 800px;
  }

  .site-header__info-item {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(50% - 4px);
    align-items: center;
    gap: 8px;
    background: var(--info-bar-bg);
    color: var(--info-bar-fg);
    padding: 5px 12px 5px 5px;
    border-radius: var(--radius-full);
    min-height: 40px;
    text-align: left;
    line-height: 1.1;
    min-width: 0;
    display: inline-flex;
    opacity: 0;
    transform: rotateY(90deg);
    transform-origin: center;
    backface-visibility: hidden;
    transition: opacity 250ms ease, transform 500ms cubic-bezier(0.4, 0.2, 0.2, 1);
    pointer-events: none;
    will-change: transform, opacity;
  }

  .site-header__info-item.is-slot-1 {
    left: 0;
    right: auto;
    opacity: 1;
    transform: rotateY(0);
    pointer-events: auto;
    transition-delay: 0ms;
  }

  .site-header__info-item.is-slot-2 {
    left: auto;
    right: 0;
    opacity: 1;
    transform: rotateY(0);
    pointer-events: auto;
    transition-delay: 80ms;
  }

  /* Fallback sin JS: pintar los primeros 2 items en sus slots via nth-of-type. */
  .site-header__info-scroll:not([data-carousel-ready]) .site-header__info-item:nth-of-type(1) {
    left: 0;
    right: auto;
    opacity: 1;
    transform: rotateY(0);
  }
  .site-header__info-scroll:not([data-carousel-ready]) .site-header__info-item:nth-of-type(2) {
    left: auto;
    right: 0;
    opacity: 1;
    transform: rotateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__info-item {
      transition: opacity 150ms ease;
      transform: rotateY(0);
    }
  }

  /* Circulo blanco con el icono en color turquesa (el mismo del fondo
     de la pastilla) */
  .site-header__info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--info-bar-fg);
    color: var(--info-bar-bg);
    flex: 0 0 auto;
  }

  .site-header__info-icon svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  .site-header__info-text-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .site-header__info-title {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .site-header__info-title strong {
    font-weight: 800;
  }

  .site-header__info-subtitle {
    font-size: 9.5px;
    font-weight: 500;
    line-height: 1.15;
    opacity: 0.9;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  /* ============================================================
     Chips de colecciones (block collection_chips)
     ============================================================ */
  .site-header__chips {
    background: var(--color-bg);
    padding: 4px 0;
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .site-header__chips-scroll {
    display: flex;
    gap: 4px;
    padding: 0 var(--space-md);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  .site-header__chips-scroll::-webkit-scrollbar { display: none; }

  .site-header__chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: 0 0 auto;
    scroll-snap-align: start;
    padding: 3px 9px;
    background: var(--color-bg-soft);
    color: var(--color-text);
    text-decoration: none;
    font-size: 11px;
    font-weight: var(--font-weight-strong);
    white-space: nowrap;
    transition: background 150ms ease, color 150ms ease;
    min-height: 24px;
    line-height: 1.1;
  }

  .site-header__chips--pill .site-header__chip { border-radius: var(--radius-full); }
  .site-header__chips--rounded .site-header__chip { border-radius: var(--radius-md); }
  .site-header__chips--square .site-header__chip { border-radius: 0; }

  .site-header__chip:hover,
  .site-header__chip:focus-visible {
    background: var(--color-border);
  }

  .site-header__chip.is-active {
    background: var(--color-brand-secondary);
    color: var(--color-bg);
  }

  .site-header__chip--placeholder {
    opacity: 0.6;
    font-style: italic;
  }

  .site-header__chips--with-image .site-header__chip {
    padding: 2px 8px 2px 2px;
    min-height: 28px;
  }

  .site-header__chip-image {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--color-bg);
    overflow: hidden;
    flex: 0 0 auto;
  }

  .site-header__chips--rounded.site-header__chips--with-image .site-header__chip-image,
  .site-header__chips--square.site-header__chips--with-image .site-header__chip-image {
    border-radius: var(--radius-sm);
  }

  .site-header__chip-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .site-header__chip-initial {
    font-size: 11px;
    font-weight: var(--font-weight-heading);
    color: var(--color-text-muted);
  }

  .site-header__chip-image--all svg {
    width: 13px;
    height: 13px;
    color: var(--color-text-muted);
  }

  .site-header__chip.is-active .site-header__chip-image {
