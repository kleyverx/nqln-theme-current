{%- comment -%}
  Header principal del tema NQLN.

  Commit 1 (mobile basico funcional):
  - Layout mobile-first: [search] [logo centrado] [account, wishlist, cart]
  - Sin JS: cada icono es un link a la pagina correspondiente
  - Iconos SVG inline (estilo outline, 1.5 stroke, currentColor)
  - Semantico: <header> con <nav> implicito, ARIA labels en cada action
  - Tokens: usa var(--color-*), var(--space-*), var(--font-*)

  Proximos commits:
  - 2: sticky on scroll (custom element)
  - 3: marquee section (aparte)
  - 4: beneficios strip + BCV mobile
  - 5: search modal + drawer nav mobile
  - 6: desktop fila superior (turquesa)
  - 7: mega menus desktop sticky
{%- endcomment -%}

<header class="site-header" id="Header" role="banner">
  <div class="site-header__inner page-width">

    {%- if section.settings.show_search -%}
      <a
        class="site-header__action site-header__action--left"
        href="{{ routes.search_url }}"
        aria-label="{{ 'sections.header.aria_search' | t }}"
      >
        <svg class="site-header__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
    {%- endif -%}

    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_width = section.settings.logo_width | default: 120 -%}
        {%- assign logo_ratio = section.settings.logo.aspect_ratio | default: 1 -%}
        {%- assign logo_height = logo_width | divided_by: logo_ratio -%}
        {{
          section.settings.logo
          | image_url: width: 480
          | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              width: logo_width,
              height: logo_height,
              alt: shop.name,
              class: 'site-header__logo-image'
        }}
      {%- else -%}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="site-header__actions site-header__actions--right">
      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a
          class="site-header__action"
          href="{{ routes.account_url }}"
          aria-label="{{ 'sections.header.aria_account' | t }}"
        >
          <svg class="site-header__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.show_wishlist -%}
        <a
          class="site-header__action"
          href="/pages/{{ section.settings.wishlist_page_handle | default: 'wish-list' }}"
          aria-label="{{ 'sections.header.aria_wishlist' | t }}"
        >
          <svg class="site-header__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="site-header__badge" data-wishlist-count aria-hidden="true">0</span>
        </a>
      {%- endif -%}

      <a
        class="site-header__action site-header__action--cart"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'sections.header.aria_cart' | t }}"
      >
        <svg class="site-header__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="site-header__badge site-header__badge--cart" aria-label="{{ cart.item_count }} items en el carrito">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>

  </div>
</header>

{% stylesheet %}
  /* Header — mobile first */
  .site-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    z-index: 100;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-sm);
    min-height: 56px;
    padding-top: var(--space-sm);
    padding-bottom: var(--space-sm);
  }

  .site-header__logo {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-text);
    max-width: 60vw;
  }

  .site-header__logo-image {
    display: block;
    height: auto;
    max-height: 36px;
    width: auto;
    object-fit: contain;
  }

  .site-header__logo-text {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--color-text);
    white-space: nowrap;
  }

  .site-header__actions {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .site-header__actions--right {
    justify-self: end;
  }

  .site-header__action {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background 150ms ease, color 150ms ease;
  }

  .site-header__action:hover,
  .site-header__action:focus-visible {
    background: var(--color-bg-soft);
  }

  .site-header__action--left {
    justify-self: start;
  }

  .site-header__icon {
    width: 22px;
    height: 22px;
    display: block;
  }

  .site-header__badge {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: var(--radius-full);
    background: var(--color-brand-primary);
    color: var(--color-text);
    font-size: 11px;
    font-weight: var(--font-weight-strong);
    line-height: 18px;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .site-header__badge--cart {
    background: var(--color-brand-secondary);
    color: var(--color-bg);
  }

  /* Hide wishlist badge cuando esta en 0 (evita ver "0" cuando el user no tiene nada). */
  .site-header__badge[data-wishlist-count]:not([data-count]) {
    display: none;
  }

  /* Tablet & up: mas aire, iconos ligeramente mas grandes */
  @media (min-width: 750px) {
    .site-header__inner {
      min-height: 64px;
      gap: var(--space-md);
    }

    .site-header__logo-image {
      max-height: 42px;
    }

    .site-header__icon {
      width: 24px;
      height: 24px;
    }

    .site-header__actions {
      gap: var(--space-xs);
    }
  }

  /* Desktop 990+: header con logo mas grande. En commit 6 se anade la barra
     superior turquesa con beneficios/BCV y en commit 7 los megamenus. */
  @media (min-width: 990px) {
    .site-header__inner {
      min-height: 72px;
    }

    .site-header__logo-image {
      max-height: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "shopify-section-header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Recomendado: PNG/SVG con transparencia, alto <= 100px"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Ancho maximo del logo (px)",
      "min": 60,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Elementos visibles"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Mostrar buscador",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Mostrar cuenta",
      "default": true,
      "info": "Solo aparece si tienes cuentas de cliente habilitadas en la tienda."
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Mostrar wishlist",
      "default": true
    },
    {
      "type": "text",
      "id": "wishlist_page_handle",
      "label": "Handle de la pagina de wishlist",
      "default": "wish-list",
      "info": "Sin barra al principio. Ej: 'wish-list' apunta a /pages/wish-list"
    },
    {
      "type": "header",
      "content": "Navegacion"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu",
      "info": "Se muestra completo en desktop (commit siguiente). En mobile se accede desde el drawer."
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
