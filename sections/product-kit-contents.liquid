      },
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "1 bomba de extracción de aire VAULI"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "10 bolsas grandes 30 x 35 cm"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "10 bolsas medianas 22 x 21 cm"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "1 cable de carga USB-C"
          }
        }
      ]
    }
  ]
}
{% endschema %}
