{%- comment -%}
  Product Testimonials — reseñas manuales curadas para páginas de producto.
  3-6 cards con estrellas Unicode (filled y outline), quote en <blockquote>
  semántico, nombre y ciudad del autor. Sin JS, solo CSS.
  Estética VAULI/METRIKASA: hueso #f6f5f1, negro #1a1a1a, estrellas #ffb800.

  Fuente de la reseña: la sección es manual (no viene de app de reseñas).
  Curada por la tienda para prueba social antes del CTA de cierre.

  GOTCHA :empty — el tema oculta cualquier <div> vacío con `:empty { display:none }`.
  Las estrellas siempre se llenan (bucle fijo 1..5) y el quote/autor solo se
  renderizan si tienen contenido. El contenedor de estrellas fuerza display:block
  por defensa.

  Rating a11y — la fila de estrellas se marca role="img" con aria-label legible
  (ej. "Calificación: 5 de 5") y cada <span> visual va aria-hidden.
{%- endcomment -%}

{%- style -%}
  #ProductTestimonials-{{ section.id }} {
    --pt-bg: {{ section.settings.bg_color | default: '#f6f5f1' }};
    --pt-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --pt-star: {{ section.settings.star_color | default: '#ffb800' }};
    --pt-max-width: {{ section.settings.content_max_width | default: 1200 }}px;
    background-color: var(--pt-bg);
    color: var(--pt-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 749px) {
    #ProductTestimonials-{{ section.id }} {
      padding-top: 40px !important;
      padding-bottom: 40px !important;
    }
    #ProductTestimonials-{{ section.id }} .product-testimonials__inner {
      padding-left: 1.6rem !important;
      padding-right: 1.6rem !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
      margin-left: auto !important;
      margin-right: auto !important;
      width: 100% !important;
    }
  }
{%- endstyle -%}

<div id="ProductTestimonials-{{ section.id }}" class="product-testimonials">
  <div class="product-testimonials__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="product-testimonials__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="product-testimonials__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="product-testimonials__subheading rte">
        {{ section.settings.subheading }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="product-testimonials__grid" role="list">
        {%- for block in section.blocks -%}
          {%- assign rating = block.settings.rating | default: 5 -%}
          <li
            class="product-testimonials__item"
            style="--pt-index: {{ forloop.index0 }};"
            {{ block.shopify_attributes }}
          >
            <article class="product-testimonials__card">
              <div
                class="product-testimonials__stars"
                role="img"
                aria-label="Calificación: {{ rating }} de 5"
                style="display:block;"
              >
                {%- for i in (1..5) -%}
                  {%- if i <= rating -%}
                    <span class="product-testimonials__star product-testimonials__star--filled" aria-hidden="true">★</span>
                  {%- else -%}
                    <span class="product-testimonials__star product-testimonials__star--empty" aria-hidden="true">☆</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if block.settings.quote != blank -%}
                <blockquote class="product-testimonials__quote">
                  {{ block.settings.quote | escape | newline_to_br }}
                </blockquote>
              {%- endif -%}

              {%- if block.settings.author_name != blank or block.settings.author_location != blank -%}
                <footer class="product-testimonials__author">
                  {%- if block.settings.author_name != blank -%}
                    <cite class="product-testimonials__author-name">{{ block.settings.author_name }}</cite>
                  {%- endif -%}
                  {%- if block.settings.author_location != blank -%}
                    <span class="product-testimonials__author-location">{{ block.settings.author_location }}</span>
                  {%- endif -%}
                </footer>
              {%- endif -%}
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="product-testimonials__placeholder">Agrega bloques de reseña desde el editor.</p>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="product-testimonials__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-testimonials__inner {
    max-width: var(--pt-max-width, 1200px);
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
    text-align: center;
  }

  .product-testimonials__eyebrow {
    margin: 0 0 1rem;
    font-size: clamp(1.2rem, 1.4vw, 1.4rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.72;
  }

  .product-testimonials__heading {
    margin: 0 0 1.2rem;
    font-size: clamp(2.2rem, 3.8vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: inherit;
  }

  .product-testimonials__subheading {
    margin: 0 auto;
    max-width: 62ch;
    font-size: clamp(1.5rem, 1.8vw, 1.7rem);
    line-height: 1.5;
    color: inherit;
    opacity: 0.85;
  }

  .product-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin: 3.2rem 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .product-testimonials__item {
    /* Entrada escalonada al cargar */
    animation: product-testimonials-in 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--pt-index, 0) * 90ms);
  }

  .product-testimonials__card {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding: 2.4rem;
    height: 100%;
    background-color: color-mix(in srgb, var(--pt-bg) 78%, #ffffff 22%);
    border: 1px solid color-mix(in srgb, var(--pt-text) 8%, transparent);
    border-radius: 14px;
    box-sizing: border-box;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  .product-testimonials__card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--pt-star) 55%, transparent);
    box-shadow: 0 14px 30px -18px color-mix(in srgb, var(--pt-text) 60%, transparent);
    background-color: color-mix(in srgb, var(--pt-bg) 60%, #ffffff 40%);
  }

  .product-testimonials__stars {
    display: flex;
    gap: 0.2rem;
    font-size: clamp(1.8rem, 2.2vw, 2.2rem);
    line-height: 1;
    letter-spacing: 0.05em;
  }

  .product-testimonials__star--filled {
    color: var(--pt-star);
  }

  .product-testimonials__star--empty {
    color: var(--pt-star);
    opacity: 0.28;
  }

  .product-testimonials__quote {
    margin: 0;
    font-size: clamp(1.55rem, 1.8vw, 1.75rem);
    line-height: 1.55;
    font-weight: 500;
    color: inherit;
  }

  .product-testimonials__quote::before {
    content: "\201C";
    display: inline-block;
    margin-right: 0.1em;
    color: var(--pt-star);
    font-weight: 700;
  }

  .product-testimonials__quote::after {
    content: "\201D";
    display: inline-block;
    margin-left: 0.05em;
    color: var(--pt-star);
    font-weight: 700;
  }

  .product-testimonials__author {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 1.4rem;
    line-height: 1.35;
  }

  .product-testimonials__author-name {
    font-style: normal;
    font-weight: 700;
    color: inherit;
  }

  .product-testimonials__author-location {
    color: inherit;
    opacity: 0.7;
  }

  .product-testimonials__footnote {
    margin: 3.2rem 0 0;
    font-size: 1.3rem;
    line-height: 1.4;
    color: inherit;
    opacity: 0.65;
    text-align: center;
  }

  .product-testimonials__placeholder {
    margin: 2rem 0;
    font-size: 1.4rem;
    opacity: 0.6;
  }

  @keyframes product-testimonials-in {
    0% {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Tablet: 2 columnas */
  @media (max-width: 989px) {
    .product-testimonials__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Movil: 1 columna */
  @media (max-width: 749px) {
    .product-testimonials__grid {
      grid-template-columns: 1fr;
      gap: 1.6rem;
      margin-top: 2.4rem;
    }
    .product-testimonials__card {
      padding: 2rem;
      border-radius: 12px;
    }
    .product-testimonials__inner {
      padding-left: 1.6rem;
      padding-right: 1.6rem;
    }
    .product-testimonials__heading {
      font-size: clamp(2rem, 6vw, 2.6rem);
      margin-bottom: 0.8rem;
    }
    .product-testimonials__eyebrow {
      font-size: 1.15rem;
    }
  }

  /* Respeta prefers-reduced-motion: sin animaciones */
  @media (prefers-reduced-motion: reduce) {
    .product-testimonials__item,
    .product-testimonials__card,
    .product-testimonials__card:hover {
      animation: none;
      transition: none;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reseñas del producto",
  "tag": "section",
  "class": "section section-product-testimonials",
  "settings": [
    {
      "type": "paragraph",
      "content": "Rejilla de 3–6 reseñas manuales con estrellas, cita, nombre y ciudad. Curada por ti (no viene de una app de reseñas). Ideal como prueba social antes del CTA de cierre."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (texto pequeño encima del título)",
      "default": "Reseñas de clientes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Los que ya lo usan, lo recomiendan"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subtítulo (opcional)"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Nota al pie (opcional)",
      "info": "Aparece pequeño debajo de las reseñas."
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#f6f5f1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Color de las estrellas",
      "default": "#ffb800"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho máximo del contenido",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "testimonial",
      "name": "Reseña",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Calificación (estrellas)",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Reseña / cita",
          "default": "Excelente producto. Lo recomiendo."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Nombre del cliente",
          "default": "María G."
        },
        {
          "type": "text",
          "id": "author_location",
          "label": "Ciudad",
          "default": "Caracas"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VAULI — Reseñas",
      "settings": {
        "eyebrow": "Reseñas de clientes",
        "heading": "Los que ya lo usan, lo recomiendan",
        "footnote": "Reseñas de clientes de NQLN Store",
        "bg_color": "#f6f5f1",
        "text_color": "#1a1a1a",
        "star_color": "#ffb800",
        "content_max_width": 1200,
        "padding_top": 64,
        "padding_bottom": 64
      },
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "El queso me duraba 4 días, ahora me dura semanas. Pagó solo con lo que dejé de botar.",
            "author_name": "María G.",
            "author_location": "Caracas"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Organizé todo el freezer con porciones planas. Cabe el doble y sé qué hay en cada bolsa.",
            "author_name": "José R.",
            "author_location": "Valencia"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Lo cargo como un teléfono y lo guardo en cualquier gaveta. Lo uso cada vez que hago mercado.",
            "author_name": "Andreína M.",
            "author_location": "Maracaibo"
          }
        }
      ]
    }
  ]
}
{% endschema %}
