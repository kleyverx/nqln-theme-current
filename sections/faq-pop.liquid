{%- comment -%}
  Sección FAQ "pop" — estilo METRIKASA / CAT.
  Tarjetas de pregunta amarillas en grid de 3 columnas; al hacer clic la
  respuesta se despliega JUSTO DEBAJO dentro de su celda del grid.
  Implementado con Web Component nativo (botón + panel, aria-expanded) para
  controlar el "abre-debajo" dentro del grid y el efecto pop scale-bounce.
  Varias respuestas pueden estar abiertas a la vez (no acordeón exclusivo).
{%- endcomment -%}

{%- style -%}
  #faq-pop-{{ section.id }} {
    --faq-card-bg: {{ section.settings.card_color | default: '#ffcd11' }};
    --faq-q-text: {{ section.settings.question_text_color | default: '#1a1a1a' }};
    --faq-answer-bg: {{ section.settings.answer_bg_color | default: '#f6f5f1' }};
    --faq-answer-text: {{ section.settings.answer_text_color | default: '#232323' }};
    --faq-accent: {{ section.settings.accent_color | default: '#1a1a1a' }};
    --faq-title-color: {{ section.settings.title_color | default: '#1a1a1a' }};
    --faq-title-align: {{ section.settings.title_alignment | default: 'center' }};
  }
  #faq-pop-{{ section.id }} .faq-pop__inner {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
    padding-left: {{ section.settings.padding_horizontal | default: 50 }}px;
    padding-right: {{ section.settings.padding_horizontal | default: 50 }}px;
  }
  @media (max-width: 749px) {
    #faq-pop-{{ section.id }} .faq-pop__inner {
      padding-left: {{ section.settings.padding_horizontal | default: 50 | times: 0.4 | round: 0 }}px;
      padding-right: {{ section.settings.padding_horizontal | default: 50 | times: 0.4 | round: 0 }}px;
    }
  }
{%- endstyle -%}

<section
  id="faq-pop-{{ section.id }}"
  class="faq-pop"
>
  <div class="faq-pop__inner page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="faq-pop__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <faq-pop-list class="faq-pop__grid">
        {%- for block in section.blocks -%}
          {%- assign panel_id = 'faq-panel-' | append: section.id | append: '-' | append: forloop.index -%}
          <div class="faq-pop__cell" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="faq-pop__question"
              aria-expanded="false"
              aria-controls="{{ panel_id }}"
            >
              <span class="faq-pop__question-text">
                {{- block.settings.question | default: '¿Una pregunta?' -}}
              </span>
              <span class="faq-pop__icon" aria-hidden="true">
                <span class="faq-pop__icon-bar faq-pop__icon-bar--h"></span>
                <span class="faq-pop__icon-bar faq-pop__icon-bar--v"></span>
              </span>
            </button>
            <div
              id="{{ panel_id }}"
              class="faq-pop__answer"
              role="region"
              hidden
            >
              <div class="faq-pop__answer-inner rte">
                {%- if block.settings.answer != blank -%}
                  {{ block.settings.answer }}
                {%- else -%}
                  <p>Escribe aquí la respuesta a tu pregunta.</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </faq-pop-list>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    if (customElements.get('faq-pop-list')) return;

    class FaqPopList extends HTMLElement {
      connectedCallback() {
        this.addEventListener('click', this.onClick.bind(this));
      }

      onClick(event) {
        var button = event.target.closest('.faq-pop__question');
        if (!button || !this.contains(button)) return;

        var panelId = button.getAttribute('aria-controls');
        var panel = panelId ? this.querySelector('#' + CSS.escape(panelId)) : null;
        if (!panel) return;

        var isOpen = button.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          this.close(button, panel);
        } else {
          this.open(button, panel);
        }
      }

      open(button, panel) {
        button.setAttribute('aria-expanded', 'true');
        panel.hidden = false;

        var reduce =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Micro-pop en la tarjeta.
        button.classList.remove('is-popping');
        void button.offsetWidth;
        if (!reduce) button.classList.add('is-popping');

        // Efecto pop scale-bounce en la respuesta.
        panel.classList.remove('is-opening');
        void panel.offsetWidth;
        if (!reduce) panel.classList.add('is-opening');

        var cell = button.closest('.faq-pop__cell');
        if (cell) cell.classList.add('is-open');
      }

      close(button, panel) {
        button.setAttribute('aria-expanded', 'false');
        panel.classList.remove('is-opening');
        panel.hidden = true;
        var cell = button.closest('.faq-pop__cell');
        if (cell) cell.classList.remove('is-open');
      }
    }

    customElements.define('faq-pop-list', FaqPopList);
  })();
</script>

{% stylesheet %}
  .faq-pop__inner {
    width: 100%;
  }

  .faq-pop__title {
    text-align: var(--faq-title-align, center);
    color: var(--faq-title-color, #1a1a1a);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 6vw, 5rem);
    margin: 0 0 2.4rem;
    font-stretch: condensed;
  }

  .faq-pop__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    grid-auto-flow: dense;
    gap: 1.4rem;
  }

  .faq-pop__cell {
    display: flex !important;
    flex-direction: column;
    min-width: 0;
  }

  .faq-pop__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    width: 100%;
    text-align: left;
    cursor: pointer;
    border: 0;
    border-radius: 0;
    padding: 1.5rem 1.7rem;
    background: var(--faq-card-bg, #ffcd11);
    color: var(--faq-q-text, #1a1a1a);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1.3;
    transition: filter 0.2s ease, box-shadow 0.2s ease;
    -webkit-appearance: none;
    appearance: none;
  }

  .faq-pop__question:hover {
    filter: brightness(0.96);
  }

  .faq-pop__question:focus-visible {
    outline: 3px solid var(--faq-accent, #1a1a1a);
    outline-offset: 2px;
  }

  .faq-pop__question-text {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Signo "+" construido con dos barras; la barra vertical rota a "x"/oculta. */
  .faq-pop__icon {
    position: relative;
    flex: 0 0 auto;
    display: block !important;
    width: 22px;
    height: 22px;
  }

  .faq-pop__icon-bar {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block !important;
    width: 20px;
    height: 3px;
    border-radius: 3px;
    background: var(--faq-accent, #1a1a1a);
    transform: translate(-50%, -50%);
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
  }

  .faq-pop__icon-bar--v {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  /* Abierto: "+" gira 45° para formar "×". */
  .faq-pop__question[aria-expanded='true'] .faq-pop__icon-bar--h {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .faq-pop__question[aria-expanded='true'] .faq-pop__icon-bar--v {
    transform: translate(-50%, -50%) rotate(135deg);
  }

  .faq-pop__answer {
    margin-top: 0.9rem;
    border-radius: 0;
    background: var(--faq-answer-bg, #f6f5f1);
    color: var(--faq-answer-text, #232323);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    transform-origin: top center;
  }

  .faq-pop__answer[hidden] {
    display: none !important;
  }

  /* Forzar display:block por la regla global :empty { display:none } del tema. */
  .faq-pop__answer-inner {
    display: block !important;
    padding: 1.4rem 1.7rem;
    font-size: 1.45rem;
    line-height: 1.55;
  }

  .faq-pop__answer-inner > :first-child {
    margin-top: 0;
  }

  .faq-pop__answer-inner > :last-child {
    margin-bottom: 0;
  }

  .faq-pop__answer-inner a {
    color: inherit;
    text-decoration: underline;
  }

  /* Efecto POP scale-bounce al abrir la respuesta. */
  .faq-pop__answer.is-opening {
    animation: faqPopBounce 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  /* Micro-pop de la tarjeta al hacer clic. */
  .faq-pop__question.is-popping {
    animation: faqCardPop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes faqPopBounce {
    0% {
      opacity: 0;
      transform: scale(0.9);
    }
    60% {
      opacity: 1;
      transform: scale(1.05);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes faqCardPop {
    0% {
      transform: scale(1);
    }
    45% {
      transform: scale(0.97);
    }
    75% {
      transform: scale(1.03);
    }
    100% {
      transform: scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .faq-pop__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .faq-pop__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.1rem;
    }
    .faq-pop__question {
      font-size: 1.5rem;
      padding: 1.4rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-pop__answer.is-opening,
    .faq-pop__question.is-popping {
      animation: none;
    }
    .faq-pop__icon-bar {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section faq-pop-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "FAQ"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Alineación del título",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Colores de las tarjetas"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Color de la tarjeta (pregunta)",
      "default": "#ffcd11"
    },
    {
      "type": "color",
      "id": "question_text_color",
      "label": "Color del texto de la pregunta",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento (signo +)",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Colores de la respuesta"
    },
    {
      "type": "color",
      "id": "answer_bg_color",
      "label": "Color de fondo de la respuesta",
      "default": "#f6f5f1"
    },
    {
      "type": "color",
      "id": "answer_text_color",
      "label": "Color del texto de la respuesta",
      "default": "#232323"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Margen lateral (izq./der.)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50,
      "info": "Separa el contenido de los bordes. En móvil se reduce al 40%."
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Una pregunta?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Respuesta",
          "default": "<p>Escribe aquí la respuesta a tu pregunta.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "¿Hacen envíos a todo el país?",
            "answer": "<p>Sí, realizamos envíos a nivel nacional. Los tiempos y costos varían según tu ubicación.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "¿Qué métodos de pago aceptan?",
            "answer": "<p>Aceptamos varios métodos de pago. Selecciona el que prefieras al finalizar tu compra.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "¿Cuánto tarda en llegar mi pedido?",
            "answer": "<p>El tiempo de entrega depende de tu zona. Te notificaremos el estado de tu envío.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "¿Puedo cambiar o devolver un producto?",
            "answer": "<p>Sí, contamos con política de cambios y devoluciones. Contáctanos para gestionarlo.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "¿Los productos tienen garantía?",
            "answer": "<p>Nuestros productos cuentan con garantía. Consulta las condiciones según el artículo.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "¿Cómo puedo contactarlos?",
            "answer": "<p>Puedes escribirnos por WhatsApp o a través de nuestras redes sociales. Estamos para ayudarte.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
