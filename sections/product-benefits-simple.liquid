{%- comment -%}
  Product Benefits Simple — versión MINIMALISTA de "Beneficios clave" (mockup VAULI).
  Sin íconos, sin fondos por tarjeta, sin bordes, sin shadows. Solo tipografía:
  eyebrow verde + H2 grande + grid de N cards con H3 en negrita y párrafo.
  Sección hermana de product-benefits-pop (esa lleva íconos/tarjetas grandes).

  GOTCHA :empty — el tema oculta cualquier <div> vacío con `:empty { display:none }`.
  Por eso solo renderizamos wrappers cuando hay contenido real.

  Tamaños: las CSS vars de tipografía se emiten DIRECTAMENTE en rem desde Liquid
  (dividido entre 10) para evitar el bug `calc(px * rem)` inválido si se
  intentara multiplicar por una unidad rem en CSS.
{%- endcomment -%}

{%- liquid
  assign columns = section.settings.columns | default: 3
  assign heading_size_rem = section.settings.heading_size | default: 32 | divided_by: 10.0
  assign card_title_size_rem = section.settings.card_title_size | default: 18 | divided_by: 10.0
-%}

{%- style -%}
  #ProductBenefitsSimple-{{ section.id }} {
    --pbs-bg: {{ section.settings.bg_color | default: '#f6f5f1' }};
    --pbs-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --pbs-eyebrow: {{ section.settings.eyebrow_color | default: '#20b19e' }};
    --pbs-heading-size: {{ heading_size_rem }}rem;
    --pbs-card-title-size: {{ card_title_size_rem }}rem;
    --pbs-max-width: {{ section.settings.content_max_width | default: 1100 }}px;
    --pbs-columns: {{ columns }};
    background-color: var(--pbs-bg);
    color: var(--pbs-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 749px) {
    #ProductBenefitsSimple-{{ section.id }} {
      padding-top: 40px !important;
      padding-bottom: 40px !important;
    }
    #ProductBenefitsSimple-{{ section.id }} .product-benefits-simple__inner {
      padding-left: 1.6rem !important;
      padding-right: 1.6rem !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
      margin-left: auto !important;
      margin-right: auto !important;
      width: 100% !important;
    }
  }
{%- endstyle -%}

<div id="ProductBenefitsSimple-{{ section.id }}" class="product-benefits-simple">
  <div class="product-benefits-simple__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="product-benefits-simple__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="product-benefits-simple__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="product-benefits-simple__grid" role="list">
        {%- for block in section.blocks -%}
          <li
            class="product-benefits-simple__item"
            style="--pbs-index: {{ forloop.index0 }};"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.title != blank -%}
              <h3 class="product-benefits-simple__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="product-benefits-simple__card-desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-benefits-simple__inner {
    max-width: var(--pbs-max-width, 1100px);
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
    text-align: center;
  }

  .product-benefits-simple__eyebrow {
    margin: 0 0 1.2rem;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--pbs-eyebrow, #20b19e);
  }

  .product-benefits-simple__heading {
    margin: 0 0 3.2rem;
    font-size: var(--pbs-heading-size, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: inherit;
    text-wrap: balance;
  }

  .product-benefits-simple__grid {
    display: grid;
    grid-template-columns: repeat(var(--pbs-columns, 3), minmax(0, 1fr));
    gap: 3.2rem 2.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-benefits-simple__item {
    text-align: center;
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .product-benefits-simple__card-title {
    margin: 0 0 0.8rem;
    font-size: var(--pbs-card-title-size, 1.8rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: inherit;
  }

  .product-benefits-simple__card-desc {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.55;
    color: inherit;
    opacity: 0.82;
    text-wrap: pretty;
  }

  /* Tablet: si son 4 columnas colapsa a 2; 3 y 2 se mantienen manejables. */
  @media (max-width: 989px) {
    .product-benefits-simple__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.8rem 2rem;
    }
    .product-benefits-simple__heading {
      margin-bottom: 2.8rem;
    }
  }

  /* Móvil: 1 columna, stack vertical. */
  @media (max-width: 749px) {
    .product-benefits-simple__inner {
      padding-left: 1.6rem;
      padding-right: 1.6rem;
    }
    .product-benefits-simple__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .product-benefits-simple__eyebrow {
      font-size: 1.1rem;
      letter-spacing: 0.2em;
    }
    .product-benefits-simple__heading {
      font-size: clamp(2.2rem, 6vw, var(--pbs-heading-size, 3.2rem));
      margin-bottom: 2.4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Beneficios simples",
  "tag": "section",
  "class": "section section-product-benefits-simple",
  "settings": [
    {
      "type": "paragraph",
      "content": "Bloque minimalista de beneficios: eyebrow + título + 3 columnas de texto puro. Sin íconos ni tarjetas. Pensado para páginas de producto tipo landing (mockup VAULI)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior (eyebrow)",
      "default": "Beneficios clave"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título principal",
      "default": "Tu mercado rinde más desde el primer sellado"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columnas en escritorio",
      "options": [
        { "value": "2", "label": "2 columnas" },
        { "value": "3", "label": "3 columnas" },
        { "value": "4", "label": "4 columnas" }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#f6f5f1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color de la etiqueta superior",
      "default": "#20b19e"
    },
    {
      "type": "header",
      "content": "Tamaños"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Tamaño del título de cada beneficio",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho máximo del contenido",
      "min": 640,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "beneficio",
      "name": "Beneficio",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título del beneficio",
          "default": "Beneficio"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción",
          "default": "Descripción del beneficio."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VAULI — Beneficios claros",
      "blocks": [
        {
          "type": "beneficio",
          "settings": {
            "title": "Conserva hasta 5 veces más",
            "description": "Carnes, quesos, frutas y vegetales duran semanas en lugar de días. Sin aire, sin olores cruzados, sin quemadura por hielo."
          }
        },
        {
          "type": "beneficio",
          "settings": {
            "title": "Tu mercado rinde más",
            "description": "Cada bolsa sellada es comida que no se bota. Compra en cantidad, porciona en casa y deja de perder lo que pagaste."
          }
        },
        {
          "type": "beneficio",
          "settings": {
            "title": "Inalámbrico, siempre listo",
            "description": "Se carga por USB-C como un teléfono. Es compacto, no ocupa espacio y cabe en cualquier gaveta de la cocina."
          }
        }
      ]
    }
  ]
}
{% endschema %}
