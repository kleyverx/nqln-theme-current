{%- comment -%}
  Franja informativa debajo del header con "mensajes de seguridad"
  (beneficios: envio gratis, pago contra entrega, garantia, etc.) y
  la tasa BCV.

  Configurable por blocks — el merchant agrega/reordena/elimina items
  desde el theme editor:
  - Bloque 'benefit': icono + texto corto
  - Bloque 'bcv_rate': tasa auto-actualizada (max 1)

  Layout mobile-first:
  - Scroll horizontal si no caben todos los items (con scroll-snap
    para feeling suave)
  - Indicador de degradado a los lados cuando hay overflow
  - Sin JS pesado. Auto-update BCV opcional via fetch a API publica.

  Se incluye en header-group.json despues del 'header' principal.
{%- endcomment -%}

{%- liquid
  assign bg_color = section.settings.bg_color | default: settings.color_brand_secondary
  assign text_color = section.settings.text_color | default: '#ffffff'
-%}

<div
  class="header-info-bar"
  role="region"
  aria-label="{{ 'sections.info_bar.aria_label' | t }}"
  style="--info-bar-bg: {{ bg_color }}; --info-bar-fg: {{ text_color }};"
>
  <div class="header-info-bar__scroll">
    {%- for block in section.blocks -%}

      {%- case block.type -%}

        {%- when 'benefit' -%}
          <div class="header-info-bar__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="header-info-bar__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'shipping' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                  {%- when 'payment' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                  {%- when 'lock' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  {%- when 'support' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3v4Z"/><path d="M3 19a2 2 0 0 0 2 2h1v-6H3v4Z"/></svg>
                  {%- when 'return' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 4v5h5"/></svg>
                  {%- when 'gift' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg>
                {%- endcase -%}
              </span>
            {%- endif -%}
            <span class="header-info-bar__text">{{ block.settings.text }}</span>
          </div>

        {%- when 'bcv_rate' -%}
          <div class="header-info-bar__item header-info-bar__item--bcv" {{ block.shopify_attributes }}>
            <span class="header-info-bar__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </span>
            <span class="header-info-bar__text">
              {{ block.settings.label }}
              <strong data-bcv-rate>{{ block.settings.manual_rate | money_without_currency | default: block.settings.manual_rate }}</strong>
              {{ block.settings.suffix }}
            </span>
            {%- if block.settings.auto_update -%}
              <script data-bcv-auto-update
                data-endpoint="{{ block.settings.api_endpoint | default: 'https://pydolarve.org/api/v1/dollar?page=bcv' }}"
                data-key-path="{{ block.settings.api_key_path | default: 'monitors.bcv.price' }}"
              ></script>
            {%- endif -%}
          </div>

      {%- endcase -%}

    {%- else -%}
      {%- if request.design_mode -%}
        <div class="header-info-bar__item header-info-bar__item--placeholder">
          <span class="header-info-bar__text">{{ 'sections.info_bar.placeholder' | t }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .header-info-bar {
    background: var(--info-bar-bg);
    color: var(--info-bar-fg);
    font-size: 12px;
    line-height: 1.3;
    font-weight: var(--font-weight-strong);
    letter-spacing: 0.01em;
    overflow: hidden;
    position: relative;
  }

  .header-info-bar__scroll {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: 8px var(--space-md);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  .header-info-bar__scroll::-webkit-scrollbar {
    display: none;
  }

  .header-info-bar__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 0 0 auto;
    scroll-snap-align: start;
    white-space: nowrap;
  }

  .header-info-bar__item--placeholder {
    opacity: 0.6;
    font-style: italic;
  }

  .header-info-bar__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .header-info-bar__icon svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  .header-info-bar__text {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }

  .header-info-bar__text strong {
    font-weight: 800;
  }

  .header-info-bar__item--bcv {
    padding-left: var(--space-md);
    border-left: 1px solid rgba(255, 255, 255, 0.25);
  }

  /* Degradado a la derecha cuando hay overflow (indica scroll) */
  .header-info-bar::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 24px;
    background: linear-gradient(to right, transparent, var(--info-bar-bg));
    pointer-events: none;
  }

  @media (min-width: 750px) {
    .header-info-bar__scroll {
      gap: var(--space-lg);
      padding: 10px var(--space-lg);
      justify-content: center;
      overflow-x: visible;
    }

    .header-info-bar__icon svg {
      width: 18px;
      height: 18px;
    }

    .header-info-bar::after {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Auto-update BCV: fetch a API publica (default pydolarve.org)
  // Silent fail — si el API esta caido, mantiene el valor manual.
  document.querySelectorAll('script[data-bcv-auto-update]').forEach((script) => {
    const endpoint = script.dataset.endpoint;
    const keyPath = script.dataset.keyPath || '';
    const target = script.previousElementSibling?.querySelector('[data-bcv-rate]');
    if (!endpoint || !target) return;

    fetch(endpoint, { headers: { 'Accept': 'application/json' } })
      .then((r) => r.ok ? r.json() : Promise.reject())
      .then((data) => {
        const value = keyPath.split('.').reduce((obj, k) => obj?.[k], data);
        if (value == null) return;
        const num = typeof value === 'number' ? value : parseFloat(value);
        if (Number.isFinite(num)) {
          target.textContent = num.toLocaleString('es-VE', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          });
        }
      })
      .catch(() => {}); // silent — mantiene manual_rate
  });
{% endjavascript %}

{% schema %}
{
  "name": "Franja informativa",
  "class": "shopify-section-info-bar",
  "settings": [
    {
      "type": "paragraph",
      "content": "Franja horizontal con mensajes de seguridad, beneficios y tasa BCV. Editas cada item agregando bloques abajo. En mobile hace scroll horizontal si no caben todos."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "info": "Deja vacío para usar el color secundario del tema (turquesa)."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio / Mensaje de seguridad",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "none", "label": "Ninguno" },
            { "value": "shipping", "label": "Envío / Camión" },
            { "value": "payment", "label": "Pago / Tarjeta" },
            { "value": "shield", "label": "Escudo / Garantía" },
            { "value": "check", "label": "Check" },
            { "value": "lock", "label": "Pago seguro" },
            { "value": "support", "label": "Soporte 24/7" },
            { "value": "return", "label": "Devolución" },
            { "value": "gift", "label": "Regalo" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envío gratis desde 30$"
        }
      ]
    },
    {
      "type": "bcv_rate",
      "name": "Tasa BCV",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta",
          "default": "BCV:"
        },
        {
          "type": "text",
          "id": "manual_rate",
          "label": "Tasa manual (Bs por USD)",
          "info": "Se muestra si el auto-update está desactivado o si el API falla.",
          "default": "50.00"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Sufijo",
          "default": "Bs"
        },
        {
          "type": "checkbox",
          "id": "auto_update",
          "label": "Actualizar automáticamente",
          "info": "Consulta la tasa oficial del BCV desde una API pública gratuita. Silent fail si el API está caído — se mantiene la tasa manual.",
          "default": true
        },
        {
          "type": "url",
          "id": "api_endpoint",
          "label": "Endpoint del API (avanzado)",
          "info": "Deja vacío para usar pydolarve.org (default). Debe devolver JSON."
        },
        {
          "type": "text",
          "id": "api_key_path",
          "label": "Ruta al valor en el JSON (avanzado)",
          "info": "Ej: 'monitors.bcv.price' para pydolarve. Separado por puntos.",
          "default": "monitors.bcv.price"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Franja informativa",
      "blocks": [
        {
          "type": "benefit",
          "settings": { "icon": "shipping", "text": "Envío gratis desde 30$" }
        },
        {
          "type": "benefit",
          "settings": { "icon": "payment", "text": "Pago contra entrega" }
        },
        {
          "type": "benefit",
          "settings": { "icon": "shield", "text": "Garantía de 6 meses" }
        },
        {
          "type": "bcv_rate",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}
