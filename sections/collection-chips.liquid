{%- comment -%}
  Chips horizontales scrolleables generados a partir de un menu de
  Shopify. El merchant NO agrega colecciones una por una — solo elige
  UN menu ya creado (ej: 'main-menu' o un menu 'chips-categorias' que
  cree en Navegacion), y todos los items del menu se convierten en
  chips automaticamente.

  Cada item:
  - Titulo del link como texto del chip
  - URL del link como destino
  - Si el link apunta a una coleccion (collection_link), se usa la
    imagen de la coleccion (o del primer producto) para el thumbnail
    opcional. Para links que no son colecciones (paginas, productos,
    URLs externas), fallback a la inicial del titulo.

  Layout mobile-first: flex row + scroll-snap. Chips compactos.
{%- endcomment -%}

{%- liquid
  assign menu = linklists[section.settings.menu]
  assign current_handle = collection.handle | default: ''
  assign chip_style = section.settings.chip_style | default: 'pill'
  assign show_image = section.settings.show_image
  assign has_items = false
  if menu != blank and menu.links.size > 0
    assign has_items = true
  endif
-%}

{%- if has_items -%}
  <nav
    class="collection-chips collection-chips--{{ chip_style }} {% if show_image %}collection-chips--with-image{% endif %}"
    role="navigation"
    aria-label="{{ 'sections.collection_chips.aria_label' | t }}"
  >
    <div class="collection-chips__scroll">
      {%- if section.settings.show_all_link and section.settings.all_url != blank -%}
        <a
          class="collection-chips__item"
          href="{{ section.settings.all_url }}"
        >
          {%- if show_image -%}
            <span class="collection-chips__image collection-chips__image--all" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            </span>
          {%- endif -%}
          <span class="collection-chips__name">{{ section.settings.all_label | default: 'Ver todo' }}</span>
        </a>
      {%- endif -%}

      {%- for link in menu.links -%}
        {%- assign is_active = false -%}
        {%- if link.type == 'collection_link' and link.object.handle == current_handle -%}
          {%- assign is_active = true -%}
        {%- endif -%}
        {%- assign chip_img = blank -%}
        {%- if link.type == 'collection_link' and link.object -%}
          {%- assign chip_img = link.object.image | default: link.object.products.first.featured_image -%}
        {%- elsif link.type == 'product_link' and link.object -%}
          {%- assign chip_img = link.object.featured_image -%}
        {%- endif -%}

        <a
          class="collection-chips__item {% if is_active %}is-active{% endif %}"
          href="{{ link.url }}"
          {% if is_active %}aria-current="page"{% endif %}
        >
          {%- if show_image -%}
            <span class="collection-chips__image">
              {%- if chip_img != blank -%}
                {{ chip_img | image_url: width: 80 | image_tag: loading: 'lazy', width: 40, height: 40, alt: link.title, class: 'collection-chips__img' }}
              {%- else -%}
                <span class="collection-chips__initial" aria-hidden="true">{{ link.title | slice: 0, 1 | upcase }}</span>
              {%- endif -%}
            </span>
          {%- endif -%}
          <span class="collection-chips__name">{{ link.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </nav>
{%- elsif request.design_mode -%}
  <div class="collection-chips">
    <div class="collection-chips__scroll">
      <div class="collection-chips__item collection-chips__item--placeholder">
        <span class="collection-chips__name">{{ 'sections.collection_chips.placeholder' | t }}</span>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .collection-chips {
    background: var(--color-bg);
    padding: 6px 0;
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .collection-chips__scroll {
    display: flex;
    gap: 6px;
    padding: 0 var(--space-md);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  .collection-chips__scroll::-webkit-scrollbar {
    display: none;
  }

  .collection-chips__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 0 0 auto;
    scroll-snap-align: start;
    padding: 5px 12px;
    background: var(--color-bg-soft);
    color: var(--color-text);
    text-decoration: none;
    font-size: 12px;
    font-weight: var(--font-weight-strong);
    white-space: nowrap;
    transition: background 150ms ease, color 150ms ease;
    min-height: 30px;
    line-height: 1.1;
  }

  .collection-chips--pill .collection-chips__item {
    border-radius: var(--radius-full);
  }

  .collection-chips--rounded .collection-chips__item {
    border-radius: var(--radius-md);
  }

  .collection-chips--square .collection-chips__item {
    border-radius: 0;
  }

  .collection-chips__item:hover,
  .collection-chips__item:focus-visible {
    background: var(--color-border);
  }

  .collection-chips__item.is-active {
    background: var(--color-brand-secondary);
    color: var(--color-bg);
  }

  .collection-chips__item--placeholder {
    opacity: 0.6;
    font-style: italic;
  }

  /* Variante con imagen: chip un poco mas alto para dar espacio al thumbnail. */
  .collection-chips--with-image .collection-chips__item {
    padding: 3px 10px 3px 3px;
    min-height: 36px;
  }

  .collection-chips__image {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    background: var(--color-bg);
    overflow: hidden;
    flex: 0 0 auto;
  }

  .collection-chips--rounded.collection-chips--with-image .collection-chips__image,
  .collection-chips--square.collection-chips--with-image .collection-chips__image {
    border-radius: var(--radius-sm);
  }

  .collection-chips__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collection-chips__initial {
    font-size: 13px;
    font-weight: var(--font-weight-heading);
    color: var(--color-text-muted);
  }

  .collection-chips__image--all svg {
    width: 16px;
    height: 16px;
    color: var(--color-text-muted);
  }

  .collection-chips__item.is-active .collection-chips__image {
    background: rgba(255, 255, 255, 0.2);
  }

  .collection-chips__item.is-active .collection-chips__initial,
  .collection-chips__item.is-active .collection-chips__image--all svg {
    color: var(--color-bg);
  }

  @media (min-width: 750px) {
    .collection-chips {
      padding: 10px 0;
    }
    .collection-chips__scroll {
      padding: 0 var(--space-lg);
      gap: 8px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .collection-chips__item {
      font-size: 13px;
      padding: 6px 14px;
      min-height: 32px;
    }

    .collection-chips--with-image .collection-chips__item {
      padding: 4px 12px 4px 4px;
      min-height: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chips de colecciones",
  "class": "shopify-section-collection-chips",
  "settings": [
    {
      "type": "paragraph",
      "content": "Genera chips horizontales a partir de un menú de Shopify. Ve a Contenido → Menús, crea un menú con los links que quieras (ej: 'chips-categorias'), y aquí lo seleccionas. Cada link del menú se convierte en un chip automáticamente."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú",
      "default": "main-menu",
      "info": "Cada link del menú aparece como un chip. Si el link es a una colección, se puede mostrar su imagen."
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "select",
      "id": "chip_style",
      "label": "Forma de los chips",
      "options": [
        { "value": "pill", "label": "Pastilla (redondeado)" },
        { "value": "rounded", "label": "Rectángulo redondeado" },
        { "value": "square", "label": "Cuadrado" }
      ],
      "default": "pill"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Mostrar miniatura",
      "info": "Thumbnail circular a la izquierda del texto. Se usa la imagen de la colección (o del primer producto) si el link apunta a una colección. Si no, se muestra la inicial del título.",
      "default": false
    },
    {
      "type": "header",
      "content": "Chip 'Ver todo' (opcional)"
    },
    {
      "type": "checkbox",
      "id": "show_all_link",
      "label": "Mostrar chip 'Ver todo' al inicio",
      "default": false
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Texto",
      "default": "Ver todo"
    },
    {
      "type": "url",
      "id": "all_url",
      "label": "URL",
      "info": "Ej: /collections (todas las colecciones) o /collections/all (todos los productos)."
    }
  ],
  "presets": [
    {
      "name": "Chips de colecciones"
    }
  ]
}
{% endschema %}
