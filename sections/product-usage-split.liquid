{%- comment -%}
  Product Usage Split — bloque "Fácil de usar" con imagen a un lado y lista
  numerada vertical al otro. Estética VAULI: fondo hueso #f6f5f1, eyebrow
  verde #20b19e, números en círculo amarillo #ffcd11 sobre negro #1a1a1a.

  Diferencia clave con product-usage-steps: aquel es un timeline HORIZONTAL
  con línea de conexión; este es un SPLIT 2 columnas (imagen ↔ pasos) con
  la lista apilada verticalmente. Pensado para "Listo en menos de un minuto"
  del mockup VAULI (https://xd23xuy6o3qwm.kimi.page).

  Sin JS. Solo Liquid + CSS. Mobile: stack vertical (imagen arriba).
{%- endcomment -%}

{%- liquid
  assign img_pos = section.settings.image_position | default: 'left'
-%}

{%- style -%}
  #ProductUsageSplit-{{ section.id }} {
    --pus-bg: {{ section.settings.bg_color | default: '#f6f5f1' }};
    --pus-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --pus-eyebrow: {{ section.settings.eyebrow_color | default: '#20b19e' }};
    --pus-number-bg: {{ section.settings.number_bg | default: '#ffcd11' }};
    --pus-number-color: {{ section.settings.number_color | default: '#1a1a1a' }};
    --pus-heading-size: {{ section.settings.heading_size | divided_by: 10.0 }}rem;
    --pus-number-size: {{ section.settings.number_size | divided_by: 10.0 }}rem;
    --pus-max-width: {{ section.settings.content_max_width | default: 1100 }}px;
    background-color: var(--pus-bg);
    color: var(--pus-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div id="ProductUsageSplit-{{ section.id }}" class="product-usage-split product-usage-split--image-{{ img_pos }}">
  <div class="product-usage-split__inner">

    <div class="product-usage-split__media">
      {%- if section.settings.image != blank -%}
        {%- assign img = section.settings.image -%}
        {{ img
          | image_url: width: 1200
          | image_tag:
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(max-width: 749px) 92vw, (max-width: 989px) 46vw, 540px',
            alt: img.alt | default: section.settings.heading | default: shop.name,
            loading: 'lazy',
            class: 'product-usage-split__img'
        }}
      {%- else -%}
        {%- if request.design_mode -%}
          <div class="product-usage-split__placeholder" aria-hidden="true">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'product-usage-split__placeholder-svg' }}
          </div>
        {%- else -%}
          <div class="product-usage-split__placeholder product-usage-split__placeholder--blank" aria-hidden="true"></div>
        {%- endif -%}
      {%- endif -%}
    </div>

    <div class="product-usage-split__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="product-usage-split__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="product-usage-split__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="product-usage-split__subheading rte">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ol class="product-usage-split__steps" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'paso' -%}
              {%- liquid
                assign step_num = block.settings.number_override | default: forloop.index | append: ''
              -%}
              <li class="product-usage-split__step" {{ block.shopify_attributes }}>
                <span class="product-usage-split__number" aria-hidden="true">{{ step_num }}</span>
                <div class="product-usage-split__text">
                  {%- if block.settings.title != blank -%}
                    <p class="product-usage-split__step-title">{{ block.settings.title }}</p>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="product-usage-split__step-desc">{{ block.settings.description }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .product-usage-split__inner {
    max-width: var(--pus-max-width, 1100px);
    margin: 0 auto;
    padding-left: 1.6rem;
    padding-right: 1.6rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4.8rem;
    align-items: center;
  }

  /* Invertir orden cuando la imagen va a la derecha */
  .product-usage-split--image-right .product-usage-split__media {
    order: 2;
  }
  .product-usage-split--image-right .product-usage-split__content {
    order: 1;
  }

  .product-usage-split__media {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1.2rem;
    background: rgba(0, 0, 0, 0.04);
  }

  .product-usage-split__img,
  .product-usage-split__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-usage-split__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(0, 0, 0, 0.25);
  }

  .product-usage-split__placeholder--blank {
    background: repeating-linear-gradient(
      45deg,
      rgba(0, 0, 0, 0.03),
      rgba(0, 0, 0, 0.03) 12px,
      rgba(0, 0, 0, 0.06) 12px,
      rgba(0, 0, 0, 0.06) 24px
    );
  }

  .product-usage-split__content {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .product-usage-split__eyebrow {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pus-eyebrow, #20b19e);
  }

  .product-usage-split__heading {
    margin: 0;
    font-size: var(--pus-heading-size, 3.2rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: inherit;
  }

  .product-usage-split__subheading {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.55;
    opacity: 0.8;
  }

  .product-usage-split__steps {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .product-usage-split__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.4rem;
    align-items: start;
  }

  .product-usage-split__number {
    width: var(--pus-number-size, 4.4rem);
    height: var(--pus-number-size, 4.4rem);
    border-radius: 50%;
    background: var(--pus-number-bg, #ffcd11);
    color: var(--pus-number-color, #1a1a1a);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: calc(var(--pus-number-size, 4.4rem) * 0.4);
    line-height: 1;
    flex-shrink: 0;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.08);
  }

  .product-usage-split__text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.4rem;
  }

  .product-usage-split__step-title {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.35;
    color: inherit;
  }

  .product-usage-split__step-desc {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.55;
    opacity: 0.75;
  }

  /* Tablet */
  @media (max-width: 989px) {
    .product-usage-split__inner {
      gap: 3.2rem;
    }
    .product-usage-split__heading {
      font-size: calc(var(--pus-heading-size, 3.2rem) * 0.85);
    }
  }

  /* Móvil: stack vertical, imagen arriba siempre */
  @media (max-width: 749px) {
    .product-usage-split__inner {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
    .product-usage-split--image-right .product-usage-split__media,
    .product-usage-split--image-right .product-usage-split__content {
      order: initial;
    }
    .product-usage-split__media {
      aspect-ratio: 1 / 1;
    }
    .product-usage-split__heading {
      font-size: calc(var(--pus-heading-size, 3.2rem) * 0.75);
    }
    .product-usage-split__step {
      gap: 1.2rem;
    }
    .product-usage-split__number {
      width: calc(var(--pus-number-size, 4.4rem) * 0.85);
      height: calc(var(--pus-number-size, 4.4rem) * 0.85);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Modo de uso (split)",
  "tag": "section",
  "class": "section section-product-usage-split",
  "settings": [
    {
      "type": "paragraph",
      "content": "Split imagen + lista numerada vertical. Ideal para 'Fácil de usar / Listo en menos de un minuto'. En móvil se apila (imagen arriba, pasos abajo)."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen del producto en uso"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de la imagen (escritorio)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (texto pequeño superior)",
      "default": "Fácil de usar"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título principal",
      "default": "Listo en menos de un minuto"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subtítulo (opcional)"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo",
      "default": "#f6f5f1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#20b19e"
    },
    {
      "type": "color",
      "id": "number_bg",
      "label": "Fondo del círculo (número)",
      "default": "#ffcd11"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Color del número",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Tamaños"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Tamaño del círculo de número",
      "min": 32,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho máximo del contenido",
      "min": 640,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título del paso"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción"
        },
        {
          "type": "text",
          "id": "number_override",
          "label": "Número personalizado (opcional)",
          "info": "Déjalo vacío para autonumerar 1, 2, 3…"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VAULI — Fácil de usar",
      "blocks": [
        {
          "type": "paso",
          "settings": {
            "title": "Llena la bolsa con el alimento",
            "description": "Sin sobrellenarla: deja espacio para el sellado."
          }
        },
        {
          "type": "paso",
          "settings": {
            "title": "Cierra herméticamente la válvula",
            "description": "El cierre de la bolsa queda completamente sellado."
          }
        },
        {
          "type": "paso",
          "settings": {
            "title": "Presiona el botón y la bomba extrae el aire",
            "description": "Succión de alta eficiencia, sin calor, sin dañar el alimento."
          }
        },
        {
          "type": "paso",
          "settings": {
            "title": "Retira cuando compacte y guarda",
            "description": "Directo a la nevera o al freezer, plano y etiquetado."
          }
        }
      ]
    }
  ]
}
{% endschema %}
