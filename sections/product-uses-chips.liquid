{%- comment -%}
  Product Uses Chips — split imagen + eyebrow + H2 + párrafo + wrap de chips.
  Estética VAULI/METRIKASA: fondo hueso #f6f5f1, negro #1a1a1a. Cada chip
  es un pill con border-radius grande; opcionalmente enlazable a una URL
  (colección, filtro, página). Solo CSS, sin JS.

  GOTCHA :empty — el tema oculta cualquier <div> vacío con `:empty { display:none }`.
  Por eso el contenedor de la imagen fuerza display:block y muestra un placeholder
  en el editor cuando no hay imagen cargada.

  GOTCHA CSS comments — nunca escribir tags Liquid dentro de comentarios CSS
  del bloque {%- style -%} (Shopify los parsea y rompe la sección).
{%- endcomment -%}

{%- liquid
  assign img_pos = section.settings.image_position | default: 'left'
-%}

{%- style -%}
  #ProductUsesChips-{{ section.id }} {
    --puc-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --puc-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --puc-accent: {{ section.settings.accent_color | default: '#20b19e' }};
    --puc-chip-bg: {{ section.settings.chip_bg | default: '#f6f5f1' }};
    --puc-chip-color: {{ section.settings.chip_color | default: '#1a1a1a' }};
    --puc-max-width: {{ section.settings.content_max_width | default: 1100 }}px;
    background-color: var(--puc-bg);
    color: var(--puc-text);
    padding-top: {{ section.settings.padding_top | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
  }
{%- endstyle -%}

<div id="ProductUsesChips-{{ section.id }}" class="product-uses-chips">
  <div
    class="product-uses-chips__inner page-width"
    data-image-position="{{ img_pos }}"
    style="max-width: var(--puc-max-width); margin: 0 auto;"
  >
    <div class="product-uses-chips__media" style="display:block;">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image
          | image_url: width: 1200
          | image_tag:
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(max-width: 749px) 100vw, (max-width: 989px) 50vw, 550px',
            alt: section.settings.heading | default: shop.name,
            loading: 'lazy',
            class: 'product-uses-chips__img'
        }}
      {%- elsif request.design_mode -%}
        <div class="product-uses-chips__placeholder" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.4">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <circle cx="9" cy="10" r="1.5"></circle>
            <path d="M21 16l-5-4-8 8"></path>
          </svg>
        </div>
      {%- else -%}
        <span class="product-uses-chips__placeholder-dot" aria-hidden="true" style="display:block;"></span>
      {%- endif -%}
    </div>

    <div class="product-uses-chips__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="product-uses-chips__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="product-uses-chips__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="product-uses-chips__body rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="product-uses-chips__chips" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.label != blank -%}
              <li class="product-uses-chips__chip-item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="product-uses-chips__chip product-uses-chips__chip--link">
                    <span>{{ block.settings.label }}</span>
                  </a>
                {%- else -%}
                  <span class="product-uses-chips__chip">
                    <span>{{ block.settings.label }}</span>
                  </span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .product-uses-chips__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  /* image_position = right → invierte el orden visual de las columnas */
  .product-uses-chips__inner[data-image-position='right'] .product-uses-chips__media {
    order: 2;
  }

  .product-uses-chips__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 1.2rem;
    background-color: var(--puc-chip-bg, #f6f5f1);
  }

  .product-uses-chips__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-uses-chips__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: currentColor;
    opacity: 0.35;
  }

  .product-uses-chips__placeholder-dot {
    width: 100%;
    height: 100%;
    background: currentColor;
    opacity: 0.06;
  }

  .product-uses-chips__content {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .product-uses-chips__eyebrow {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--puc-accent, currentColor);
  }

  .product-uses-chips__heading {
    margin: 0;
    font-size: clamp(2.2rem, 3.6vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: inherit;
  }

  .product-uses-chips__body {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1.55;
    color: inherit;
  }

  .product-uses-chips__body > *:first-child { margin-top: 0; }
  .product-uses-chips__body > *:last-child { margin-bottom: 0; }

  .product-uses-chips__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 0.8rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .product-uses-chips__chip-item {
    display: inline-flex;
  }

  .product-uses-chips__chip {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.6rem;
    background-color: var(--puc-chip-bg, #f6f5f1);
    color: var(--puc-chip-color, #1a1a1a);
    border-radius: 999px;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.005em;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .product-uses-chips__chip--link:hover,
  .product-uses-chips__chip--link:focus-visible {
    text-decoration: none;
    color: var(--puc-chip-color, #1a1a1a);
    border-color: currentColor;
    transform: translateY(-1px);
  }

  .product-uses-chips__chip--link:focus-visible {
    outline: 2px solid var(--puc-chip-color, #1a1a1a);
    outline-offset: 3px;
  }

  /* Tablet: sigue en 2 columnas pero con menos gap */
  @media (max-width: 989px) {
    .product-uses-chips__inner {
      gap: 2.4rem;
    }
    .product-uses-chips__media {
      aspect-ratio: 1 / 1;
    }
  }

  /* Móvil: stack vertical, imagen arriba (ignora image_position) */
  @media (max-width: 749px) {
    .product-uses-chips__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .product-uses-chips__inner[data-image-position='right'] .product-uses-chips__media {
      order: 0;
    }
    .product-uses-chips__media {
      aspect-ratio: 16 / 10;
    }
    .product-uses-chips__chips {
      gap: 0.6rem;
    }
    .product-uses-chips__chip {
      font-size: 1.3rem;
      padding: 0.7rem 1.3rem;
    }
  }

  /* Respeta prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .product-uses-chips__chip,
    .product-uses-chips__chip--link:hover,
    .product-uses-chips__chip--link:focus-visible {
      transition: none;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Usos con chips",
  "tag": "section",
  "class": "section section-product-uses-chips",
  "settings": [
    {
      "type": "paragraph",
      "content": "Split imagen + texto + wrap de chips. Ideal para casos de uso, categorías o tags de producto. Cada chip puede llevar un enlace opcional (colección, filtro, página)."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de la imagen (desktop)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo (eyebrow)",
      "default": "Para todo lo que compras"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título (H2)",
      "default": "Un kit, toda tu cocina organizada"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Párrafo (opcional)"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color del antetítulo",
      "default": "#20b19e"
    },
    {
      "type": "color",
      "id": "chip_bg",
      "label": "Fondo de los chips",
      "default": "#f6f5f1"
    },
    {
      "type": "color",
      "id": "chip_color",
      "label": "Color del texto de los chips",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho máximo del contenido",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta",
          "default": "Categoría"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VAULI — Usos",
      "settings": {
        "eyebrow": "Para todo lo que compras",
        "heading": "Un kit, toda tu cocina organizada",
        "body": "<p>Del mercado al freezer, del freezer a la mesa. Si se come, se puede sellar.</p>",
        "image_position": "left",
        "bg_color": "#ffffff",
        "text_color": "#1a1a1a",
        "accent_color": "#20b19e",
        "chip_bg": "#f6f5f1",
        "chip_color": "#1a1a1a"
      },
      "blocks": [
        { "type": "chip", "settings": { "label": "Carnes y pescados" } },
        { "type": "chip", "settings": { "label": "Quesos y embutidos" } },
        { "type": "chip", "settings": { "label": "Frutas y vegetales" } },
        { "type": "chip", "settings": { "label": "Meal prep de la semana" } },
        { "type": "chip", "settings": { "label": "Sobras y porciones" } },
        { "type": "chip", "settings": { "label": "Marinados más rápidos al vacío" } }
      ]
    }
  ]
}
{% endschema %}
