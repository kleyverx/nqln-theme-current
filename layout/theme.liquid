    <script>
    /* Wishlist count badge: hide bubble when count is 0 or empty */
    (function () {
      var pending = false;
      function update() {
        document.querySelectorAll('.wishlist-count-bubble').forEach(function (b) {
          var t = b.querySelector('[data-wishlist-count]');
          b.style.display = (!t || !t.textContent || t.textContent === '0') ? 'none' : '';
        });
      }
      function scheduleUpdate() {
        if (pending) return;
        pending = true;
        (window.requestIdleCallback || window.requestAnimationFrame)(function() {
          pending = false;
          update();
        });
      }
      function observe() {
        update();
        document.querySelectorAll('[data-wishlist-count]').forEach(function (el) {
          if (el._wlOb) return;
          el._wlOb = true;
          new MutationObserver(scheduleUpdate).observe(el, { characterData: true, childList: true, subtree: true });
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', observe);
      } else {
        observe();
      }
    })();
    </script>
