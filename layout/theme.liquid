<!doctype html>
{%- liquid
  if settings.list_iso_rtl != blank
    assign locale_iso_code = request.locale.iso_code
    assign arr_list_rtl = settings.list_iso_rtl | remove: ' ' | split: ','
    if arr_list_rtl contains locale_iso_code
      assign enable_iso_rtl = true
    else
      assign enable_iso_rtl = false
    endif
  endif
-%}
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  {% if settings.enable_layout_rtl and enable_iso_rtl %}
    dir="rtl"
  {% endif %}
>
  <head>
    {% render 'pandectes-rules' %}

   {% comment %} {% render 'swift-optimize-master' %}{% endcomment %}

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="google-site-verification" content="QNwjxtYbP79VqvjgoZ-QjmmDVhnTGgM8RwgaBc05tIg" />
    <meta name="theme-color" content="#ffffff">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
    {%- endif -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://sibautomation.com">
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {% render 'meta-tags' %}
    <meta name="apple-itunes-app" content="app-id=6454723827">

    {%- comment -%} hreflang for multilingual SEO {%- endcomment -%}
    {%- if localization.available_languages.size > 1 -%}
      {%- for lang in localization.available_languages -%}
        <link rel="alternate" hreflang="{{ lang.iso_code }}" href="{{ canonical_url | replace: shop.url, '' | prepend: shop.url | replace: request.host, request.host }}">
      {%- endfor -%}
      <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">
    {%- endif -%}

    {%- comment -%} Product/Breadcrumb JSON-LD {%- endcomment -%}
    {% render 'schema' %}

    {%- comment -%} WebSite + SearchAction (Sitelinks Search Box in Google) {%- endcomment -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    </script>

    {%- comment -%} Organization + LocalBusiness JSON-LD {%- endcomment -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      {%- if settings.favicon != blank -%}
      "logo": "{{ settings.favicon | image_url: width: 512 }}",
      {%- endif -%}
      "sameAs": [
        {%- assign social_links = '' -%}
        {%- if settings.social_facebook_link != blank -%}{%- assign social_links = social_links | append: settings.social_facebook_link | append: ',' -%}{%- endif -%}
        {%- if settings.social_instagram_link != blank -%}{%- assign social_links = social_links | append: settings.social_instagram_link | append: ',' -%}{%- endif -%}
        {%- if settings.social_twitter_link != blank -%}{%- assign social_links = social_links | append: settings.social_twitter_link | append: ',' -%}{%- endif -%}
        {%- if settings.social_youtube_link != blank -%}{%- assign social_links = social_links | append: settings.social_youtube_link | append: ',' -%}{%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}{%- assign social_links = social_links | append: settings.social_tiktok_link -%}{%- endif -%}
        {%- assign social_arr = social_links | split: ',' -%}
        {%- for s in social_arr -%}
          {%- if s != blank -%}{{ s | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endif -%}
        {%- endfor -%}
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Store",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "image": "{{ settings.favicon | image_url: width: 512 }}",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "VE",
        "addressLocality": "Caracas"
      },
      "areaServed": {
        "@type": "Country",
        "name": "Venezuela"
      }
    }
    </script>

    {{ content_for_header }}

    {% render 'variable' %}
    {% render 'global-style' %}
    {% render 'global-script' %}
    <style>
      .card-information .scm-reviews-rate{
            margin-top: -12px;
      }

      /* === Z-index fixes: enforce stacking order so content never overlaps fixed UI === */
      /* Sticky add to cart bar (bottom) must stay on top — keep its native position: fixed */
      .halo-sticky-toolbar-mobile,
      [class*="halo-sticky-add-to-cart"],
      .product-sticky-add-to-cart,
      [class*="sticky-add-to-cart"],
      .productView-stickyCart,
      .sticky-product-mobile,
      sticky-add-to-cart {
        z-index: 9999 !important;
      }
      .show-mobile-options .productView-stickyCart.style-1,
      .productView-stickyCart.style-1.is-show,
      .sticky-product-mobile.is-show {
        z-index: 9999 !important;
      }
      /* Footer must never create a stacking context above the sticky bar */
      .wrapper-footer,
      .wrapper-footer *,
      .section-footer,
      [class*="footer"]:not([class*="sticky"]) {
        z-index: auto;
      }
      .wrapper-footer {
        position: relative;
        z-index: 1;
        isolation: auto;
      }
      /* Marquee must stay below modals/headers but above content */
      .section-marquee,
      [class*="marquee"] {
        z-index: 5 !important;
        position: relative;
      }
      /* Product description content stays in flow, never above sticky UI */
      .product-description,
      .product-tab-content,
      .product__description,
      [class*="product-tab"],
      [class*="halo-product-tab"] {
        position: relative;
        z-index: 1;
      }
      /* Mobile sticky payment buttons (Shop Pay, etc.) */
      .shopify-payment-button,
      [class*="payment-button"] {
        position: relative;
        z-index: 10;
      }
      /* Newsletter inputs/buttons should never be covered */
      .newsletter-form,
      .newsletter-form__field-wrapper,
      [class*="newsletter"] form {
        position: relative;
        z-index: 2;
      }
      /* Headers always on top */
      .section-header-mobile,
      .section-header-single-line,
      .section-header-navigation-vertical-menu,
      sticky-header,
      sticky-header-mobile {
        z-index: 100;
      }
      /* === Variant picker (global — applies on product page, cart drawer, edit popup) === */
      .productView-variants fieldset.product-form__input,
      fieldset.product-form__input {
        display: flex !important;
        flex-wrap: wrap;
        align-items: stretch;
        gap: 12px 14px;
        border: 0;
        padding: 12px 0 0 0 !important;
        margin: 0 0 18px 0 !important;
        width: 100%;
      }
      fieldset.product-form__input legend.form__label {
        width: 100%;
        margin-bottom: 8px;
        flex-basis: 100%;
      }
      .product-form__input .product-form__label {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border: 2px solid #e6e6e6;
        border-radius: 12px;
        background: #fff;
        cursor: pointer;
        transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.15s ease;
        margin: 0;
        min-height: 60px;
        min-width: 0;
        flex: 0 0 auto;
        white-space: nowrap;
        -webkit-tap-highlight-color: transparent;
        box-sizing: border-box;
      }
      .product-form__input .product-form__label.has-variant-image {
        padding: 5px 12px 5px 5px;
        gap: 10px;
      }
      .product-form__input .product-form__label .variant-thumb {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        object-fit: cover;
        display: block;
        flex-shrink: 0;
        background: #fafafa;
        border: 0;
        box-shadow: none;
      }
      .product-form__input .product-form__label .text {
        font-size: 13px;
        font-weight: 600;
        line-height: 1.2;
        color: #232323;
        letter-spacing: 0.2px;
        border: 0 !important;
        background: transparent !important;
        padding: 0 !important;
        margin: 0 !important;
        box-shadow: none !important;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
      }
      .product-form__input .product-form__label > span:not(.variant-check):not(.pattern) {
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
      }
      .product-form__input .product-form__label .variant-check {
        display: none;
        position: absolute;
        top: -8px;
        right: -8px;
        width: 26px;
        height: 26px;
        background: #20b19e !important;
        color: #fff;
        border-radius: 50%;
        align-items: center;
        justify-content: center;
        box-shadow: 0 3px 8px rgba(32,177,158,0.45) !important;
        border: 2.5px solid #fff !important;
        z-index: 3;
      }
      .product-form__input .product-form__label .variant-check svg {
        width: 16px;
        height: 16px;
        fill: #fff;
      }
      .product-form__input input[type="radio"]:checked + .product-form__label,
      .product-form__input .product-form__label.is-selected {
        border-color: #20b19e;
        background: #f0fbf8;
      }
      .product-form__input input[type="radio"]:checked + .product-form__label .variant-check,
      .product-form__input .product-form__label.is-selected .variant-check {
        display: flex;
      }
      .product-form__input .product-form__label.soldout {
        position: relative;
        opacity: 0.65;
      }
      .product-form__input .product-form__label.soldout .text {
        text-decoration: line-through;
        color: #888;
      }
      .product-form__input .product-form__label.soldout .variant-thumb,
      .product-form__input .product-form__label.soldout .pattern {
        filter: grayscale(0.6) opacity(0.8);
      }
      .product-form__input .product-form__label.soldout::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 6%;
        right: 6%;
        height: 1.5px;
        background: rgba(220, 53, 69, 0.7);
        transform: translateY(-50%) rotate(-12deg);
        pointer-events: none;
        border-radius: 2px;
      }
      .product-form__input .product-form__label.unavailable {
        opacity: 0.35;
        cursor: not-allowed;
        pointer-events: none;
      }
      .product-form__input .product-form__label.unavailable .variant-thumb,
      .product-form__input .product-form__label.unavailable .pattern {
        filter: grayscale(1);
      }
      .product-form__swatch .product-form__label {
        width: 60px;
        height: 60px;
        padding: 4px;
        border-radius: 12px;
        overflow: visible;
        background: #fff;
        min-height: unset;
      }
      .product-form__swatch .product-form__label .pattern {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        background-color: #fafafa;
        display: block;
      }
      @media (hover: hover) and (pointer: fine) {
        .product-form__input .product-form__label:hover:not(.unavailable):not(.soldout) {
          border-color: #20b19e;
          background: #f8fcfb;
        }
      }
      @media (max-width: 768px) {
        fieldset.product-form__input {
          gap: 10px 12px;
          margin-bottom: 16px !important;
        }
        .product-form__input .product-form__label {
          min-height: 44px;
          padding: 6px 12px;
          border-radius: 8px;
        }
        .product-form__input .product-form__label.has-variant-image {
          padding: 4px 12px 4px 4px;
          gap: 6px;
        }
        .product-form__input .product-form__label .variant-thumb {
          width: 36px;
          height: 36px;
        }
        .product-form__input .product-form__label .text {
          font-size: 12px;
        }
        .product-form__input .product-form__label .variant-check {
          width: 24px;
          height: 24px;
          top: -7px;
          right: -7px;
        }
        .product-form__input .product-form__label .variant-check svg {
          width: 14px;
          height: 14px;
        }
        .product-form__swatch .product-form__label {
          width: 56px;
          height: 56px;
        }
      }
      /* Performance: defer rendering of below-the-fold sections (faster LCP) */
      main > section:nth-of-type(n+4),
      main > .shopify-section:nth-of-type(n+4) {
        content-visibility: auto;
        contain-intrinsic-size: 0 500px;
      }
      /* Never apply content-visibility to fixed/sticky elements (banners, headers, modals) */
      [id*="SmartAppBanner"],
      [class*="smart-banner"],
      [class*="header"],
      [class*="sticky"],
      [style*="position: fixed"],
      [style*="position:fixed"] {
        content-visibility: visible !important;
      }
    </style>

    <script>
    (function(){
      var run = function(){
        var candidates = document.querySelectorAll('.slideshow img, .slide-show img, .image-banner img, [class*="banner"] img:not([loading="lazy"]), .product-media img, .product__media img, .product-single__photo img');
        for (var i = 0; i < candidates.length; i++) {
          var img = candidates[i];
          if (img.hasAttribute('fetchpriority')) continue;
          img.setAttribute('fetchpriority', 'high');
          img.setAttribute('loading', 'eager');
          img.setAttribute('decoding', 'sync');
          if (img.dataset && img.dataset.srcset && !img.srcset) img.srcset = img.dataset.srcset;
          if (img.dataset && img.dataset.src && !img.src) img.src = img.dataset.src;
          break;
        }
      };
      if (document.readyState !== 'loading') run();
      else {
        document.addEventListener('readystatechange', function(){
          if (document.readyState === 'interactive' || document.readyState === 'complete') run();
        });
      }
      var mo = new MutationObserver(function(){ run(); });
      mo.observe(document.documentElement, { childList: true, subtree: true });
      setTimeout(function(){ mo.disconnect(); }, 3000);
    })();
    </script>
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>

    {%- liquid
      if settings.layout_body == 'full'
        assign layout_body = 'body-full-width'
      elsif settings.layout_body == 'boxed'
        assign layout_body = 'body-boxed'
      elsif settings.layout_body == 'custom_width'
        assign layout_body = 'body-custom-width'
      endif

      if settings.style_dots == '02'
        assign style_dots = 'style-dots-2'
      endif

      if settings.style_arrows == '02'
        assign style_arrows = 'style-arrows-2'
      endif

      if settings.product_card_layout == '02'
        assign product_card_layout = 'product-card-layout-02'
      elsif settings.product_card_layout == '03'
        assign product_card_layout = 'product-card-layout-03'
      elsif settings.product_card_layout == '04'
        assign product_card_layout = 'product-card-layout-04'
      elsif settings.product_card_layout == '05'
        assign product_card_layout = 'product-card-layout-05'
      elsif settings.product_card_layout == '06'
        assign product_card_layout = 'product-card-layout-06'
      elsif settings.product_card_layout == '07'
        assign product_card_layout = 'product-card-layout-07'
      else
        assign product_card_layout = 'product-card-layout-01'
      endif

      if settings.quick_shop_type == '2'
        assign quick_shop_type = 'quick_shop_option_2'
      elsif settings.quick_shop_type == '3'
        assign quick_shop_type = 'quick_shop_option_3'
      endif

      unless request.design_mode
        if settings.banner_animation == 'effect_1'
          assign banner_animation = 'banner-animation-1'
        endif
      endunless

      if settings.style_text_size_varriant == '02'
        assign style_text_size_varriant = 'size_varriant_style_2'
      endif
    -%}

    {% render 'reviews-importer-variable-js' %}

    {%- comment -%} View Transitions API for page navigation (mobile only) {%- endcomment -%}
    {%- comment -%} Note: <meta name="view-transition"> is obsolete. The CSS @view-transition rule below is all that's needed. {%- endcomment -%}
    <style>
      @media (max-width: 1024px) {
        @view-transition {
          navigation: auto;
        }

        /* Kill ALL root animation - no flash, no fade, nothing */
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none !important;
          mix-blend-mode: normal !important;
        }

        /* Stack old and new on top of each other */
        ::view-transition-group(root) {
          animation-duration: 0s !important;
        }

        /* Header: frozen in place */
        .section-header-single-line,
        .section-header-mobile,
        .section-header-navigation-vertical-menu {
          view-transition-name: header;
        }

        ::view-transition-old(header),
        ::view-transition-new(header) {
          animation: none;
        }

        /* Toolbar mobile: frozen in place */
        .halo-sticky-toolbar-mobile {
          view-transition-name: toolbar;
        }

        ::view-transition-old(toolbar),
        ::view-transition-new(toolbar) {
          animation: none;
        }

        /* Marquee: frozen */
        .section-marquee {
          view-transition-name: marquee;
        }

        ::view-transition-old(marquee),
        ::view-transition-new(marquee) {
          animation: none;
        }

        /* Custom header banner (categories + info): frozen */
        .custom-header-banner {
          view-transition-name: header-banner;
        }

        ::view-transition-old(header-banner),
        ::view-transition-new(header-banner) {
          animation: none;
        }

        /* ONLY main content animates */
        .content-for-layout {
          view-transition-name: main-content;
        }

        ::view-transition-old(main-content) {
          animation: vt-out 0.15s ease-out forwards;
        }

        ::view-transition-new(main-content) {
          animation: vt-in 0.15s ease-out forwards;
        }

        @keyframes vt-out {
          from { opacity: 1; }
          to { opacity: 0; }
        }

        @keyframes vt-in {
          from { opacity: 0; }
          to { opacity: 1; }
        }
      }
    </style>
    <style>
      /* Ensure custom headers are visible and clean */
      /* Mobile-only header overrides */
      @media screen and (max-width: 989px) {
        sticky-header-mobile, 
        sticky-header, 
        .section-header-mobile,
        [id*="header-mobile"] {
          display: block !important;
          width: 100% !important;
          border: 0 !important;
          border-bottom: 0 !important;
          box-shadow: none !important;
          outline: none !important;
          background-image: none !important;
        }

        .header-mobile--wrapper {
          display: flex !important;
          align-items: center !important;
          justify-content: space-between !important;
          width: 100% !important;
        }

        /* Prevent iOS Safari auto-zoom on input focus (triggers at font-size < 16px) */
        input[type="search"],
        input[type="text"],
        input.search__input,
        input.field__input,
        textarea,
        select {
          font-size: 16px !important;
        }
      }

      #page-loading-bar {
        position: absolute !important;
        bottom: 0 !important;
        left: 0 !important;
        height: 2px !important;
        background-color: #20B19E !important;
        z-index: 2147483647 !important;
        width: 0;
        visibility: hidden;
        background-image: none !important;
        box-shadow: none !important;
        filter: none !important;
        border: 0 !important;
        outline: none !important;
        transition: width 0.3s cubic-bezier(0.1, 0.05, 0.4, 1);
        pointer-events: none;
        display: block !important;
      }
      #page-loading-bar.is-loading {
        visibility: visible !important;
        width: 15%;
      }
    </style>
      <script>
        // Fallback for standard reloads
        window.addEventListener('beforeunload', function() {
          var bar = document.getElementById('page-loading-bar');
          if (bar) {
            bar.classList.add('is-loading');
            bar.style.transition = 'width 2s ease-out';
            bar.style.width = '100%';
          }
        });
      </script>
      <script src="{{ 'page-transitions.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ request.page_type }} {{layout_body}} {{style_dots}} {{style_text_size_varriant}} {{style_arrows}} {{product_card_layout}} {{ banner_animation }}{% if settings.enable_button_disable_arrows %} enable_button_disable_arrows{% endif %}{% if settings.display_text_color_title %} enable_text_color_title{% endif %}{% if settings.style_text_color_varriant == '02' %} style_2_text_color_varriant{% endif %}{% if settings.hide_compare_homepage %} hide_compare_homepage{% endif %} {{ quick_shop_type }}{% if settings.show_image_loading %} show_image_loading{% endif %}{% if settings.show_effect_close %} show_effect_close{% endif %}{% if settings.enable_layout_rtl and enable_iso_rtl %} layout_rtl{% endif %}">
    <div class="body-content-wrapper">
      <!-- Letter Glitch Background Canvas - Fondo Global del Tema -->
      <div id="letter-glitch-background">
        <canvas id="glitch-canvas"></canvas>
        <div id="outer-vignette"></div>
        <div id="center-vignette"></div>
      </div>
      <a class="skip-to-content-link button visually-hidden" href="#MainContent">
        {{- 'accessibility.skip_to_text' | t -}}
      </a>

      {% render 'mws_bundle_helper' %}

      {% sections 'header-group' %}
      {% render 'wrapper-header' %}

      {% if settings.layout_body == 'boxed' %}
        <div class="wrapper-hasbanner-adv">
      {% endif %}
      {% render 'halo-banner-adv-left' %}
      {% render 'halo-banner-adv-right' %}
      <main id="MainContent" class="wrapper-body content-for-layout focus-none" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>
      {% if settings.layout_body == 'boxed' %}
        </div>
      {% endif %}

      <div class="wrapper-footer">{% sections 'footer-group' %}</div>

      {% section 'halo-toolbar-mobile' %}

      <ul hidden>
        <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      </ul>

      {% render 'global-script-2' %}
    </div>
    {% render 'halo-popup' %}
    {% render 'checkout-captcha' %}

    {%- if settings.enable_view_documentation -%}
      {% render 'theme-editor-notification' %}
    {%- endif -%}

    {% render 'theme-demo-notification' %}

    {%- if settings.use_custom_js -%}
      <script src="{{ 'custom.js' | asset_url }}" defer></script>
