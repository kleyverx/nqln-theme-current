{%- comment -%}
  Product Benefits — bloque compacto de beneficios para el sidebar del producto.
  Renderiza hasta 6 pares (ícono + título + descripción) leídos como settings del
  block `benefits` en sections/main-product.liquid. Solo pinta los slots con
  contenido: si b5/b6 están vacíos, no ocupan espacio.

  Cada beneficio se muestra en su propia tarjeta individual con fondo suave
  (`show_card`). Si se desactiva, se muestran como una lista simple con ícono
  y texto sin fondo.

  El campo ícono acepta emoji ("✅") o código SVG completo (<svg>…</svg>).
  Los SVG heredan el color del acento vía currentColor si no traen fill fijo.

  GOTCHA :empty — el tema oculta cualquier <div> vacío con `:empty { display:none }`.
  Por eso solo iteramos slots con contenido y no dejamos wrappers decorativos vacíos.
{%- endcomment -%}

{%- liquid
  assign heading = block.settings.heading
  assign show_card = block.settings.show_card
  assign text_color = block.settings.text_color | default: '#1a1a1a'
  assign accent_color = block.settings.accent_color | default: '#20b19e'
  assign card_bg = block.settings.card_bg | default: '#f6f5f1'
  assign icon_size = block.settings.icon_size | default: 44
-%}

<div
  class="product-benefits{% if show_card %} product-benefits--carded{% endif %}"
  style="--pb-text: {{ text_color }}; --pb-accent: {{ accent_color }}; --pb-card-bg: {{ card_bg }}; --pb-icon-size: {{ icon_size }}px;"
>
  {%- if heading != blank -%}
    <h3 class="product-benefits__heading">{{ heading }}</h3>
  {%- endif -%}

  <ul class="product-benefits__list" role="list">
    {%- for i in (1..6) -%}
      {%- liquid
        case i
          when 1
            assign icon = block.settings.b1_icon
            assign title = block.settings.b1_title
            assign desc = block.settings.b1_desc
          when 2
            assign icon = block.settings.b2_icon
            assign title = block.settings.b2_title
            assign desc = block.settings.b2_desc
          when 3
            assign icon = block.settings.b3_icon
            assign title = block.settings.b3_title
            assign desc = block.settings.b3_desc
          when 4
            assign icon = block.settings.b4_icon
            assign title = block.settings.b4_title
            assign desc = block.settings.b4_desc
          when 5
            assign icon = block.settings.b5_icon
            assign title = block.settings.b5_title
            assign desc = block.settings.b5_desc
          when 6
            assign icon = block.settings.b6_icon
            assign title = block.settings.b6_title
            assign desc = block.settings.b6_desc
        endcase
      -%}
      {%- if title != blank or desc != blank -%}
        <li
          class="product-benefits__item{% if show_card %} product-benefits__item--card{% endif %}"
          style="--pb-index: {{ forloop.index0 }};"
        >
          <span class="product-benefits__icon" aria-hidden="true" style="display:inline-flex;">
            {%- if icon != blank -%}
              {{ icon }}
            {%- else -%}
              {%- comment -%} Fallback: check SVG (mismo del selector de variantes) si el merchant deja el campo vacio {%- endcomment -%}
              <svg viewBox="0 0 15 15" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M11.4669 3.72684C11.7558 3.91574 11.8369 4.30308 11.648 4.59198L7.39799 11.092C7.29783 11.2452 7.13556 11.3467 6.95402 11.3699C6.77247 11.3931 6.58989 11.3355 6.45446 11.2124L3.70446 8.71241C3.44905 8.48022 3.43023 8.08494 3.66242 7.82953C3.89461 7.57412 4.28989 7.55529 4.5453 7.78749L6.75292 9.79441L10.6018 3.90792C10.7907 3.61902 11.178 3.53795 11.4669 3.72684Z"/></svg>
            {%- endif -%}
          </span>
          <span class="product-benefits__body" style="display:block;">
            {%- if title != blank -%}
              <span class="product-benefits__title" style="display:block;">{{ title }}</span>
            {%- endif -%}
            {%- if desc != blank -%}
              <span class="product-benefits__desc" style="display:block;">{{ desc }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .product-benefits {
    color: var(--pb-text, #1a1a1a);
  }

  .product-benefits__heading {
    margin: 0 0 1.2rem;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: inherit;
    line-height: 1.3;
  }

  .product-benefits__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Con tarjetas individuales, un poco más de aire entre items */
  .product-benefits--carded .product-benefits__list {
    gap: 0.8rem;
  }

  .product-benefits__item {
    display: grid;
    grid-template-columns: var(--pb-icon-size, 44px) 1fr;
    align-items: stretch;
    gap: 1.2rem;
    animation: product-benefits-in 0.4s ease-out both;
    animation-delay: calc(var(--pb-index, 0) * 60ms);
  }

  /* Tarjeta individual por beneficio (sin fondo tintado en el ícono) */
  .product-benefits__item--card {
    padding: 1.2rem 1.4rem;
    background: var(--pb-card-bg, #f6f5f1);
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .product-benefits__item--card:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }

  /* Icono limpio, sin fondo - solo el emoji o SVG a tamano configurado.
     BLINDAJE: clase duplicada (.product-benefits__icon.product-benefits__icon)
     + !important en props criticas para ganar contra el CSS global del tema
     padre Halo/Ella que aplica padding/max-width/width a img+svg. */
  .product-benefits__icon.product-benefits__icon {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: var(--pb-icon-size, 44px) !important;
    height: var(--pb-icon-size, 44px) !important;
    max-width: none !important;
    max-height: none !important;
    min-width: 0 !important;
    min-height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    align-self: center;
    font-size: calc(var(--pb-icon-size, 44px) * 0.7);
    line-height: 1;
    color: var(--pb-accent, #20b19e);
    flex-shrink: 0;
    overflow: visible !important;
  }

  /* SVG pegados en el icono: llenan el badge (via width/height 100%) y
     heredan color por currentColor SOLO si el propio SVG usa currentColor.
     BLINDAJE con !important en tamano y padding para ganar contra reglas
     globales del tema padre. */
  .product-benefits__icon.product-benefits__icon > svg {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    display: block !important;
    aspect-ratio: 1 / 1 !important;
    object-fit: contain !important;
  }

  /* CRITICO: SVGs outline (fill="none" stroke="currentColor") — el atributo
     HTML fill="none" es un presentation attribute de la mas baja especificidad,
     asi que reglas CSS del tema padre tipo "svg { fill: currentColor }" lo
     sobreescriben y rellenan el outline. Forzamos fill: none !important sobre
     el SVG y todos sus hijos cuando el raiz tiene fill="none". */
  .product-benefits__icon.product-benefits__icon svg[fill="none"],
  .product-benefits__icon.product-benefits__icon svg[fill="none"] * {
    fill: none !important;
  }
  .product-benefits__icon.product-benefits__icon svg[stroke="currentColor"],
  .product-benefits__icon.product-benefits__icon svg [stroke="currentColor"] {
    stroke: currentColor !important;
  }

  /* Cuerpo de texto centrado verticalmente respecto al ícono grande */
  .product-benefits__body {
    align-self: center;
    min-width: 0;
  }

  .product-benefits__title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    color: inherit;
  }

  .product-benefits__desc {
    margin-top: 0.3rem;
    font-size: 1.2rem;
    line-height: 1.5;
    opacity: 0.75;
    color: inherit;
  }

  @keyframes product-benefits-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 749px) {
    .product-benefits__item {
      gap: 1rem;
    }
    .product-benefits__item--card {
      padding: 1rem 1.2rem;
    }
    .product-benefits__heading {
      font-size: 1.3rem;
    }
    .product-benefits__title {
      font-size: 1.25rem;
    }
    .product-benefits__desc {
      font-size: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-benefits__item {
      animation: none;
      transition: none;
    }
    .product-benefits__item--card:hover {
      transform: none;
    }
  }
{% endstylesheet %}
