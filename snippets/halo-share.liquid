{%- comment -%}
  Halo Share (custom NQLN) — reemplaza el share-button generico por un menu
  de social apps con colores de marca. Funciona igual en desktop y mobile.

  Comportamiento:
  - Boton "Compartir" con icono. Al hacer click: despliega un popover con
    iconos coloridos de WhatsApp, Facebook, X, Telegram y Copy Link.
  - Cada icono es un <a> con la URL de share correspondiente (window.open
    en nueva pestana). Copy Link usa navigator.clipboard.
  - En mobile: si Web Share API esta disponible, un botton adicional
    "Compartir por sistema" invoca navigator.share() (menu nativo iOS/Android).
  - Toggle del popover con click fuera para cerrar (JS minimo).
  - Sin JS externo, sin dependencias. CSS/JS inline.

  Ubicacion:
  - style-1: standalone en su propia fila del sidebar (when 'share')
  - style-2: inline dentro de la fila de wishlist en buy_buttons
  - style-3: junto al titulo del producto

  Params esperados: product, share_product_type, share_product_script, share_layout
{%- endcomment -%}

{%- assign share_url = shop.url | append: product.url -%}
{%- assign share_title = product.title | strip_html | url_encode -%}
{%- assign share_url_encoded = share_url | url_encode -%}

<div class="productView-share halo-nqln-share style-{{ share_layout }}" data-nqln-share>
  <button
    type="button"
    class="share-button__button halo-nqln-share__trigger"
    aria-label="Compartir producto"
    aria-expanded="false"
    aria-controls="nqln-share-menu-{{ product.id }}"
    data-nqln-share-trigger
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    <span>Compartir</span>
  </button>

  <div
    id="nqln-share-menu-{{ product.id }}"
    class="halo-nqln-share__menu"
    role="menu"
    aria-hidden="true"
    data-nqln-share-menu
  >
    <div class="halo-nqln-share__menu-header">
      <span class="halo-nqln-share__menu-title">Compartir en</span>
      <button
        type="button"
        class="halo-nqln-share__close"
        aria-label="Cerrar"
        data-nqln-share-close
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="halo-nqln-share__grid">
      <a
        href="https://wa.me/?text={{ share_title }}%20{{ share_url_encoded }}"
        class="halo-nqln-share__app halo-nqln-share__app--whatsapp"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Compartir en WhatsApp"
      >
        <span class="halo-nqln-share__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
          </svg>
        </span>
        <span class="halo-nqln-share__label">WhatsApp</span>
      </a>

      <a
        href="https://www.facebook.com/sharer/sharer.php?u={{ share_url_encoded }}"
        class="halo-nqln-share__app halo-nqln-share__app--facebook"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Compartir en Facebook"
      >
        <span class="halo-nqln-share__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </span>
        <span class="halo-nqln-share__label">Facebook</span>
      </a>

      <a
        href="https://twitter.com/intent/tweet?url={{ share_url_encoded }}&text={{ share_title }}"
        class="halo-nqln-share__app halo-nqln-share__app--x"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Compartir en X (Twitter)"
      >
        <span class="halo-nqln-share__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </span>
        <span class="halo-nqln-share__label">X</span>
      </a>

      <a
        href="https://t.me/share/url?url={{ share_url_encoded }}&text={{ share_title }}"
        class="halo-nqln-share__app halo-nqln-share__app--telegram"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Compartir en Telegram"
      >
        <span class="halo-nqln-share__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.464.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
        </span>
        <span class="halo-nqln-share__label">Telegram</span>
      </a>

      <button
        type="button"
        class="halo-nqln-share__app halo-nqln-share__app--copy"
        data-nqln-share-copy
        data-nqln-url="{{ share_url }}"
        aria-label="Copiar enlace"
      >
        <span class="halo-nqln-share__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </span>
        <span class="halo-nqln-share__label" data-nqln-copy-label>Copiar</span>
      </button>
    </div>

    <button
      type="button"
      class="halo-nqln-share__native"
      data-nqln-share-native
      hidden
    >
      Compartir por sistema
    </button>
  </div>
</div>

<style>
  .halo-nqln-share {
    position: relative;
    display: inline-flex;
  }
  .halo-nqln-share__trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: transparent;
    color: inherit;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 8px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .halo-nqln-share__trigger:hover,
  .halo-nqln-share__trigger[aria-expanded="true"] {
    border-color: currentColor;
    background: rgba(0, 0, 0, 0.03);
  }
  .halo-nqln-share__trigger svg {
    flex-shrink: 0;
  }
  .halo-nqln-share__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 240px;
    max-width: 320px;
    padding: 14px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    pointer-events: none;
  }
  .halo-nqln-share.is-open .halo-nqln-share__menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  .halo-nqln-share__menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 10px;
  }
  .halo-nqln-share__menu-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #666;
  }
  .halo-nqln-share__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    background: transparent;
    border: 0;
    color: #666;
    cursor: pointer;
    border-radius: 4px;
  }
  .halo-nqln-share__close:hover {
    color: #000;
    background: rgba(0, 0, 0, 0.05);
  }
  .halo-nqln-share__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }
  .halo-nqln-share__app {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    padding: 8px 4px;
    background: transparent;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    font-family: inherit;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }
  .halo-nqln-share__app:hover {
    background: rgba(0, 0, 0, 0.04);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .halo-nqln-share__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: #ffffff;
  }
  .halo-nqln-share__app--whatsapp .halo-nqln-share__icon { background: #25D366; }
  .halo-nqln-share__app--facebook .halo-nqln-share__icon { background: #1877F2; }
  .halo-nqln-share__app--x        .halo-nqln-share__icon { background: #000000; }
  .halo-nqln-share__app--telegram .halo-nqln-share__icon { background: #0088CC; }
  .halo-nqln-share__app--copy     .halo-nqln-share__icon { background: #666666; }
  .halo-nqln-share__label {
    font-size: 11px;
    font-weight: 600;
    color: #333;
    line-height: 1.2;
    text-align: center;
  }
  .halo-nqln-share__native {
    display: none;
    width: 100%;
    margin-top: 10px;
    padding: 10px 14px;
    background: #1a1a1a;
    color: #ffffff;
    border: 0;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .halo-nqln-share__native:not([hidden]) { display: block; }

  /* Mobile: sheet desde abajo en vez de popover, mas facil de tocar */
  @media (max-width: 749px) {
    .halo-nqln-share__menu {
      position: fixed;
      top: auto;
      right: 0;
      bottom: 0;
      left: 0;
      min-width: 0;
      max-width: none;
      width: 100vw;
      padding: 20px 16px calc(20px + env(safe-area-inset-bottom));
      border-radius: 16px 16px 0 0;
      border-bottom: 0;
      transform: translateY(100%);
      z-index: 10000;
    }
    .halo-nqln-share.is-open .halo-nqln-share__menu {
      transform: translateY(0);
    }
    .halo-nqln-share.is-open::before {
      content: "";
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      z-index: 9999;
    }
    .halo-nqln-share__menu-title {
      font-size: 14px;
    }
    .halo-nqln-share__grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
    }
    .halo-nqln-share__icon {
      width: 48px;
      height: 48px;
    }
    .halo-nqln-share__label {
      font-size: 12px;
    }
  }
</style>

<script>
  (function () {
    var root = document.currentScript && document.currentScript.previousElementSibling
      ? document.currentScript.parentElement
      : document.querySelector('[data-nqln-share]:not([data-nqln-init])');
    var shares = document.querySelectorAll('[data-nqln-share]:not([data-nqln-init])');

    for (var i = 0; i < shares.length; i++) initShare(shares[i]);

    function initShare(container) {
      container.setAttribute('data-nqln-init', 'true');
      var trigger = container.querySelector('[data-nqln-share-trigger]');
      var menu = container.querySelector('[data-nqln-share-menu]');
      var closeBtn = container.querySelector('[data-nqln-share-close]');
      var copyBtn = container.querySelector('[data-nqln-share-copy]');
      var nativeBtn = container.querySelector('[data-nqln-share-native]');
      if (!trigger || !menu) return;

      // Mostrar boton "Compartir por sistema" solo si Web Share API existe
      if (nativeBtn && navigator.share) {
        nativeBtn.hidden = false;
        nativeBtn.addEventListener('click', function () {
          navigator.share({
            title: document.title,
            url: copyBtn ? copyBtn.getAttribute('data-nqln-url') : window.location.href
          }).catch(function () {});
        });
      }

      function open() {
        container.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
        menu.setAttribute('aria-hidden', 'false');
      }
      function close() {
        container.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
      }

      trigger.addEventListener('click', function (e) {
        e.stopPropagation();
        if (container.classList.contains('is-open')) close();
        else open();
      });
      if (closeBtn) closeBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        close();
      });

      // Click fuera del menu cierra
      document.addEventListener('click', function (e) {
        if (!container.contains(e.target)) close();
      });
      // Escape cierra
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') close();
      });

      // Copy link
      if (copyBtn) {
        var label = copyBtn.querySelector('[data-nqln-copy-label]');
        copyBtn.addEventListener('click', function () {
          var url = copyBtn.getAttribute('data-nqln-url');
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(function () {
              if (label) {
                var orig = label.textContent;
                label.textContent = '¡Copiado!';
                setTimeout(function () { label.textContent = orig; }, 1500);
              }
            }).catch(function () { fallbackCopy(url); });
          } else {
            fallbackCopy(url);
          }
        });
        function fallbackCopy(text) {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta);
          if (label) {
            var orig = label.textContent;
            label.textContent = '¡Copiado!';
            setTimeout(function () { label.textContent = orig; }, 1500);
          }
        }
      }
    }
  })();
</script>
