{%- comment -%}
  Icon Row Pop — fila horizontal de bloques ícono + etiqueta corta.
  Estética METRIKASA/CAT: amarillo #ffcd11, negro #1a1a1a, blanco hueso #f6f5f1.
  Cada block "Ícono" acepta SVG inline (textarea, prioridad) o imagen subida.
  El ícono hace un "pop" scale-bounce al pasar el mouse y una entrada
  escalonada al cargar. Solo CSS, sin JS.

  GOTCHA :empty — el tema oculta cualquier <div> vacío con `:empty { display:none }`.
  Por eso el contenedor del ícono siempre lleva contenido (SVG, imagen o, en el
  editor, un placeholder). Los elementos puramente visuales fuerzan display:block.
{%- endcomment -%}

{%- style -%}
  #IconRowPop-{{ section.id }} {
    --irp-bg: {{ section.settings.bg_color | default: '#f6f5f1' }};
    --irp-text: {{ section.settings.text_color | default: '#232323' }};
    --irp-icon-size: {{ section.settings.icon_size | default: 72 }}px;
    background-color: var(--irp-bg);
    color: var(--irp-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div id="IconRowPop-{{ section.id }}" class="icon-row-pop">
  <div class="icon-row-pop__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="icon-row-pop__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="icon-row-pop__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_svg = false
            if block.settings.svg_code != blank
              assign has_svg = true
            endif
          -%}
          <li
            class="icon-row-pop__item"
            style="--irp-index: {{ forloop.index0 }};"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="icon-row-pop__link">
            {%- else -%}
              <div class="icon-row-pop__link icon-row-pop__link--static">
            {%- endif -%}

              <span class="icon-row-pop__icon" style="display:block;">
                {%- if has_svg -%}
                  {{ block.settings.svg_code }}
                {%- elsif block.settings.image != blank -%}
                  {{ block.settings.image
                    | image_url: width: 300
                    | image_tag:
                      widths: '80, 120, 160, 240, 300',
                      sizes: '(max-width: 749px) 30vw, 120px',
                      alt: block.settings.texto | default: shop.name,
                      loading: 'lazy',
                      class: 'icon-row-pop__img'
                  }}
                {%- else -%}
                  {%- comment -%} :empty ocultaría un span vacío; placeholder solo en el editor {%- endcomment -%}
                  {%- if request.design_mode -%}
                    <span class="icon-row-pop__placeholder" style="display:block;" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" style="display:block;">
                        <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                        <path d="M8 12h8M12 8v8"></path>
                      </svg>
                    </span>
                  {%- else -%}
                    <span class="icon-row-pop__placeholder icon-row-pop__placeholder--dot" style="display:block;" aria-hidden="true"></span>
                  {%- endif -%}
                {%- endif -%}
              </span>

              {%- if block.settings.texto != blank -%}
                <span class="icon-row-pop__label">{{ block.settings.texto }}</span>
              {%- endif -%}

            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .icon-row-pop__inner {
    text-align: center;
  }

  .icon-row-pop__heading {
    margin: 0 0 2.4rem;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: inherit;
  }

  .icon-row-pop__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.4rem 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    justify-items: center;
  }

  .icon-row-pop__item {
    width: 100%;
    max-width: 220px;
  }

  .icon-row-pop__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    text-decoration: none;
    color: inherit;
  }

  .icon-row-pop__link:hover,
  .icon-row-pop__link:focus-visible {
    text-decoration: none;
    color: inherit;
  }

  /* Contenedor cuadrado del ícono */
  .icon-row-pop__icon {
    display: block;
    width: var(--irp-icon-size, 72px);
    height: var(--irp-icon-size, 72px);
    line-height: 0;
    transform-origin: center;
    will-change: transform;
    /* Entrada escalonada al cargar */
    animation: icon-row-pop-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--irp-index, 0) * 90ms);
  }

  .icon-row-pop__icon > svg,
  .icon-row-pop__img,
  .icon-row-pop__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Punto de reserva cuando no hay ícono y no estamos en el editor */
  .icon-row-pop__placeholder--dot {
    border-radius: 50%;
    background: currentColor;
    opacity: 0.12;
  }

  .icon-row-pop__label {
    display: inline-block;
    max-width: 100%;
    padding: 0.4rem 1rem;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: inherit;
    /* Etiqueta tipo barrita, una sola línea */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* POP scale-bounce en hover/focus del ícono */
  .icon-row-pop__link:hover .icon-row-pop__icon,
  .icon-row-pop__link:focus-visible .icon-row-pop__icon {
    animation: icon-row-pop-bounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .icon-row-pop__link:focus-visible {
    outline: 2px solid var(--irp-text, #232323);
    outline-offset: 4px;
    border-radius: 4px;
  }

  @keyframes icon-row-pop-in {
    0% {
      opacity: 0;
      transform: scale(0.9) translateY(8px);
    }
    60% {
      opacity: 1;
      transform: scale(1.05) translateY(0);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes icon-row-pop-bounce {
    0% {
      transform: scale(1);
    }
    35% {
      transform: scale(0.9);
    }
    70% {
      transform: scale(1.05);
    }
    100% {
      transform: scale(1);
    }
  }

  /* Tablet: 2 columnas */
  @media (max-width: 989px) {
    .icon-row-pop__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Móvil: 2 por fila, más compacto */
  @media (max-width: 749px) {
    .icon-row-pop__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.2rem;
    }
    .icon-row-pop__label {
      font-size: 1.2rem;
    }
  }

  /* Respeta prefers-reduced-motion: sin animaciones */
  @media (prefers-reduced-motion: reduce) {
    .icon-row-pop__icon,
    .icon-row-pop__link:hover .icon-row-pop__icon,
    .icon-row-pop__link:focus-visible .icon-row-pop__icon {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fila de íconos",
  "tag": "section",
  "class": "section section-icon-row-pop",
  "settings": [
    {
      "type": "paragraph",
      "content": "Fila de íconos con etiqueta corta debajo. Cada ícono hace un rebote (pop) al pasar el mouse. Usa SVG pegado o una imagen cuadrada."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título de la sección (opcional)"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#f6f5f1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#232323"
    },
    {
      "type": "header",
      "content": "Tamaño y espaciado"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Tamaño del ícono",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "icono",
      "name": "Ícono",
      "settings": [
        {
          "type": "textarea",
          "id": "svg_code",
          "label": "Código SVG (opcional)",
          "info": "Pega aquí el <svg>…</svg> completo. Si lo rellenas, tiene prioridad sobre la imagen. Útil porque Shopify suele bloquear la subida de archivos .svg."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen del ícono (PNG/JPG/WEBP)"
        },
        {
          "type": "text",
          "id": "texto",
          "label": "Texto (una línea corta)",
          "default": "Etiqueta"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fila de íconos",
      "blocks": [
        { "type": "icono", "settings": { "texto": "Envío rápido" } },
        { "type": "icono", "settings": { "texto": "Pago seguro" } },
        { "type": "icono", "settings": { "texto": "Garantía" } },
        { "type": "icono", "settings": { "texto": "Soporte 24/7" } }
      ]
    }
  ]
}
{% endschema %}
