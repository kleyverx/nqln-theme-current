{%- comment -%}
  Product Usage Steps — "Modo de uso" en 4 pasos tipo timeline.
  Diseño inspirado en el empaque HydroLoko: círculo numerado grande arriba,
  título en mayúsculas y descripción corta debajo. Desktop = timeline horizontal
  con línea conectora entre pasos; mobile = timeline vertical con círculo a la
  izquierda y texto a la derecha. Solo CSS, sin JS.

  Precargado con los 4 pasos de HydroLoko (LIMPIEZA, 1ERA CAPA, SECADO Y
  SEGUNDA CAPA, CURADO FINAL) usando marcadores romanos ① ② ③ ④ como
  number_override para replicar el empaque. Reusable: cambiar textos/colores
  desde el editor deja lista la sección para cualquier otro producto.

  GOTCHA :empty — el tema oculta cualquier <div> vacío con `:empty { display:none }`.
  Por eso los elementos puramente decorativos (línea conectora, círculo) llevan
  contenido o `style="display:block;"`.
{%- endcomment -%}

{%- style -%}
  #ProductUsageSteps-{{ section.id }} {
    --pus-bg: {{ section.settings.bg_color | default: '#1a1a1a' }};
    --pus-text: {{ section.settings.text_color | default: '#f6f5f1' }};
    --pus-number-bg: {{ section.settings.number_bg | default: '#ffcd11' }};
    --pus-number-color: {{ section.settings.number_color | default: '#1a1a1a' }};
    --pus-max-width: {{ section.settings.content_max_width | default: 960 }}px;
    background-color: var(--pus-bg);
    color: var(--pus-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div id="ProductUsageSteps-{{ section.id }}" class="product-usage-steps product-usage-steps--{{ section.settings.number_style | default: 'circle_filled' }}">
  <div class="product-usage-steps__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-usage-steps__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="product-usage-steps__subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="product-usage-steps__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign step_number = block.settings.number_override | strip
            if step_number == blank
              assign step_number = forloop.index
            endif
          -%}
          <li
            class="product-usage-steps__item"
            style="--step-index: {{ forloop.index0 }};"
            {{ block.shopify_attributes }}
          >
            <span class="product-usage-steps__number" aria-hidden="true" style="display:flex;">
              <span class="product-usage-steps__number-inner" style="display:block;">{{ step_number }}</span>
            </span>
            <div class="product-usage-steps__body">
              {%- if block.settings.title != blank -%}
                <h3 class="product-usage-steps__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="product-usage-steps__description">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- elsif request.design_mode -%}
      <div class="product-usage-steps__placeholder" style="display:block;">
        Añade pasos desde el panel de la izquierda para configurar esta sección.
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-usage-steps__inner {
    text-align: center;
    max-width: var(--pus-max-width, 960px);
    margin-left: auto;
    margin-right: auto;
  }

  .product-usage-steps__heading {
    margin: 0 0 1.2rem;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: inherit;
  }

  .product-usage-steps__subheading {
    max-width: 62ch;
    margin: 0 auto 4rem;
    font-size: clamp(1.4rem, 1.6vw, 1.7rem);
    line-height: 1.5;
    opacity: 0.85;
  }

  .product-usage-steps__subheading > *:first-child {
    margin-top: 0;
  }

  .product-usage-steps__subheading > *:last-child {
    margin-bottom: 0;
  }

  .product-usage-steps__list {
    display: grid;
    grid-template-columns: repeat(var(--pus-cols, 4), 1fr);
    gap: 3.2rem 2.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* El número de columnas viene del número de blocks: hasta 6 pasos horizontales
     en desktop, con el default 4 asumido por --pus-cols si el theme no lo pisa. */
  .product-usage-steps__list:has(> :nth-child(5)) {
    --pus-cols: 5;
  }

  .product-usage-steps__list:has(> :nth-child(6)) {
    --pus-cols: 6;
  }

  .product-usage-steps__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 0.8rem;
  }

  /* Línea/flecha conectora horizontal entre pasos (desktop).
     Se dibuja como pseudo-element del item; empieza a la derecha del círculo
     y termina antes del siguiente círculo, cruzando el gap del grid. */
  .product-usage-steps__item::after {
    content: "";
    position: absolute;
    top: calc(var(--pus-circle-size, 72px) / 2);
    left: calc(50% + (var(--pus-circle-size, 72px) / 2) + 1.2rem);
    right: calc(-50% + (var(--pus-circle-size, 72px) / 2) + 1.2rem);
    height: 2px;
    background: linear-gradient(
      to right,
      var(--pus-number-bg) 0%,
      var(--pus-number-bg) 85%,
      transparent 100%
    );
    opacity: 0.5;
    transform: translateY(-1px);
    pointer-events: none;
  }

  /* Flecha punta al final de la línea */
  .product-usage-steps__item::before {
    content: "";
    position: absolute;
    top: calc(var(--pus-circle-size, 72px) / 2);
    right: calc(-50% + (var(--pus-circle-size, 72px) / 2) + 0.6rem);
    width: 0;
    height: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 7px solid var(--pus-number-bg);
    opacity: 0.5;
    transform: translateY(-5px);
    pointer-events: none;
  }

  /* El último paso no muestra conector ni flecha */
  .product-usage-steps__item:last-child::after,
  .product-usage-steps__item:last-child::before {
    content: none;
  }

  .product-usage-steps__number {
    --pus-circle-size: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--pus-circle-size);
    height: var(--pus-circle-size);
    margin-bottom: 1.8rem;
    border-radius: 50%;
    font-size: clamp(2.4rem, 3vw, 3.2rem);
    font-weight: 800;
    line-height: 1;
    z-index: 1;
    animation: product-usage-steps-in 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--step-index, 0) * 120ms);
  }

  .product-usage-steps__number-inner {
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* Estilo relleno (default) */
  .product-usage-steps--circle_filled .product-usage-steps__number {
    background: var(--pus-number-bg);
    color: var(--pus-number-color);
    box-shadow: 0 0 0 4px rgba(255, 205, 17, 0.15);
  }

  /* Estilo contorno */
  .product-usage-steps--circle_outline .product-usage-steps__number {
    background: transparent;
    color: var(--pus-number-bg);
    border: 3px solid var(--pus-number-bg);
  }

  .product-usage-steps__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .product-usage-steps__title {
    margin: 0;
    font-size: clamp(1.5rem, 1.8vw, 1.8rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: inherit;
  }

  .product-usage-steps__description {
    margin: 0;
    font-size: clamp(1.3rem, 1.4vw, 1.5rem);
    line-height: 1.55;
    opacity: 0.85;
  }

  .product-usage-steps__placeholder {
    padding: 3.2rem 1.6rem;
    border: 2px dashed currentColor;
    border-radius: 8px;
    font-size: 1.4rem;
    opacity: 0.6;
  }

  @keyframes product-usage-steps-in {
    0% {
      opacity: 0;
      transform: scale(0.6) translateY(12px);
    }
    60% {
      opacity: 1;
      transform: scale(1.08) translateY(0);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Tablet: mantenemos el timeline horizontal pero más compacto.
     Con 4 pasos se ve bien en 989px; con 5-6 pasos se compacta un poco más. */
  @media (max-width: 989px) {
    .product-usage-steps__list {
      gap: 2.4rem 1.6rem;
    }
    .product-usage-steps__number {
      --pus-circle-size: 72px;
    }
    .product-usage-steps__item::after {
      left: calc(50% + (var(--pus-circle-size, 72px) / 2) + 0.8rem);
      right: calc(-50% + (var(--pus-circle-size, 72px) / 2) + 0.8rem);
    }
    .product-usage-steps__item::before {
      right: calc(-50% + (var(--pus-circle-size, 72px) / 2) + 0.2rem);
    }
  }

  /* Mobile: stack vertical con círculo a la izquierda y texto a la derecha.
     Espacios generosos entre pasos para respiración vertical.
     Línea conectora vertical entre círculos, cortada antes del siguiente. */
  @media (max-width: 749px) {
    .product-usage-steps__inner {
      padding-left: 1.6rem;
      padding-right: 1.6rem;
    }
    .product-usage-steps__heading {
      font-size: clamp(2.2rem, 6vw, 2.8rem);
      margin-bottom: 1rem;
    }
    .product-usage-steps__subheading {
      margin-bottom: 3.2rem;
      font-size: 1.4rem;
      max-width: none;
    }
    .product-usage-steps__list {
      grid-template-columns: 1fr;
      gap: 3.2rem;
    }
    .product-usage-steps__item {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: start;
      gap: 1.6rem;
      text-align: left;
      padding: 0;
    }
    .product-usage-steps__number {
      --pus-circle-size: 64px;
      margin-bottom: 0;
      font-size: 2.4rem;
    }
    .product-usage-steps__body {
      padding-top: 0.8rem;
      gap: 0.6rem;
    }
    .product-usage-steps__title {
      font-size: 1.55rem;
    }
    .product-usage-steps__description {
      font-size: 1.35rem;
      line-height: 1.55;
    }
    /* Conector vertical: line entre círculo actual y el siguiente.
       Se corta 0.6rem antes del siguiente círculo para dejar respiración. */
    .product-usage-steps__item::after {
      top: calc(var(--pus-circle-size, 64px) + 0.6rem);
      left: calc(var(--pus-circle-size, 64px) / 2 - 1px);
      right: auto;
      bottom: -2.6rem;
      width: 2px;
      height: auto;
      background: linear-gradient(
        to bottom,
        var(--pus-number-bg) 0%,
        var(--pus-number-bg) 85%,
        transparent 100%
      );
      opacity: 0.4;
      transform: none;
    }
    /* Flecha apunta hacia abajo en mobile */
    .product-usage-steps__item::before {
      top: auto;
      bottom: -2.6rem;
      left: calc(var(--pus-circle-size, 64px) / 2 - 5px);
      right: auto;
      border-top: 7px solid var(--pus-number-bg);
      border-bottom: 0;
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      opacity: 0.5;
      transform: none;
    }
  }

  /* Respeta prefers-reduced-motion: sin animaciones */
  @media (prefers-reduced-motion: reduce) {
    .product-usage-steps__number {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Modo de uso",
  "tag": "section",
  "class": "section section-product-usage-steps",
  "settings": [
    {
      "type": "paragraph",
      "content": "Pasos numerados grandes tipo timeline. Ideal para explicar cómo aplicar el producto en pocos pasos. Cambia colores, título y contenido desde este panel."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Modo de uso"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subtítulo (opcional)",
      "default": "<p>En solo 4 pasos, sin equipos especiales.</p>"
    },
    {
      "type": "select",
      "id": "number_style",
      "label": "Estilo del número",
      "options": [
        { "value": "circle_filled", "label": "Círculo relleno" },
        { "value": "circle_outline", "label": "Círculo con contorno" }
      ],
      "default": "circle_filled"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#f6f5f1"
    },
    {
      "type": "color",
      "id": "number_bg",
      "label": "Fondo del círculo del número",
      "default": "#ffcd11"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Color del número",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Tamaño y espaciado"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho máximo del contenido",
      "min": 480,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 960,
      "info": "Limita el ancho de la timeline. La sección se centra en la página."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título del paso",
          "default": "Paso"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción",
          "default": "Descripción del paso."
        },
        {
          "type": "text",
          "id": "number_override",
          "label": "Número personalizado (opcional)",
          "info": "Déjalo vacío para autonumerar (1, 2, 3…). O pega un carácter especial como ① ② ③ ④ para imitar el empaque."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HydroLoko — Modo de uso",
      "settings": {
        "heading": "Modo de uso",
        "subheading": "<p>En solo 4 pasos, sin equipos especiales.</p>",
        "number_style": "circle_filled",
        "bg_color": "#1a1a1a",
        "text_color": "#f6f5f1",
        "number_bg": "#ffcd11",
        "number_color": "#1a1a1a"
      },
      "blocks": [
        {
          "type": "paso",
          "settings": {
            "title": "LIMPIEZA",
            "description": "Limpia bien la superficie donde se va a aplicar HydroLoko. Debe estar libre de polvo, grasa y restos sueltos.",
            "number_override": "①"
          }
        },
        {
          "type": "paso",
          "settings": {
            "title": "1ERA CAPA",
            "description": "Aplica una primera capa con brocha o rodillo de manera uniforme sobre toda la superficie a impermeabilizar.",
            "number_override": "②"
          }
        },
        {
          "type": "paso",
          "settings": {
            "title": "SECADO Y SEGUNDA CAPA",
            "description": "Deja secar entre 4 y 6 horas. Luego aplica una segunda capa de manera perpendicular a la primera para mayor cobertura.",
            "number_override": "③"
          }
        },
        {
          "type": "paso",
          "settings": {
            "title": "CURADO FINAL",
            "description": "Deja curar por 24 horas antes del uso. Tiempo recomendado para techos, terrazas, ventanas y baños.",
            "number_override": "④"
          }
        }
      ]
    }
  ]
}
{% endschema %}
